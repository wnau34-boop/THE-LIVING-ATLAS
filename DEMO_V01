<script id="wb-story-onboarding-script">

const STORY_ONBOARDING={version:'0.2',pendingJoin:null,azureIntroShown:false};
let lioraJoined=false;
const LIORA_WILLOWGLASS={x:islands[2].x+72,y:islands[2].y+42};

function parkLioraForMeeting(){
  liora.x=LIORA_WILLOWGLASS.x;liora.y=LIORA_WILLOWGLASS.y;liora.hold=false;liora.command='waiting';liora.moving=0;
  V2.nav=[];V2.navAge=0;V2.navEpoch++;
}
function meetingAvailable(){return !lioraJoined&&active.has(2);}

// Accept save v3 while preserving v1/v2 compatibility. Old saves at/after Willowglass imply Liora was already travelling with the player.
const storyBaseSanitize=sanitizeSave;
sanitizeSave=raw=>{
  if(!raw)return null;
  let base=storyBaseSanitize(raw.version===3?{...raw,version:2}:raw);
  if(!base)return null;
  base.lioraJoined=raw.version===3?raw.lioraJoined===true:base.active.includes(2);
  return base;
};

const storyBaseFresh=fresh;
fresh=()=>{
  storyBaseFresh();
  lioraJoined=STORY_ONBOARDING.pendingJoin===true;
  if(!lioraJoined)parkLioraForMeeting();
};

save=()=>{
  if(!started)return;
  try{
    localStorage.setItem(V2.key,JSON.stringify({
      version:3,active:[...active],found:[...found],checkpoint,lens,elapsed,rescues,weaves,
      bridges:bridges.map(b=>({a:b.a,b:b.b})),
      player:stable(player)?{x:player.x,y:player.y}:null,
      liora:lioraJoined&&stable(liora)?{x:liora.x,y:liora.y}:null,
      lioraJoined,hold:lioraJoined&&liora.hold,gateTimer,cinematicSeen:V2.cinematicSeen,finished
    }));
    $('saveinfo').textContent='บันทึกอัตโนมัติแล้ว';$('saveinfo').classList.remove('savewarn');
  }catch(e){$('saveinfo').textContent='บันทึกไม่ได้ในเบราว์เซอร์นี้ · ยังเล่นต่อได้';$('saveinfo').classList.add('savewarn');}
};

function openAzureStory(){
  STORY_ONBOARDING.azureIntroShown=true;
  openModal('AZURE GATE — THE FIRST THREAD',
    '<p>คุณออกเดินทางจาก <b>Azure Gate</b> ท่ามกลางกลุ่มเกาะของ Wonderhaven แต่ทางข้ามที่แผนที่บันทึกไว้กลับไม่มีอยู่ตรงหน้า</p>'+ 
    '<p>คุณคือ <b>Wayfinder</b> ผู้เดินทางที่อ่านร่องรอยและจดจำสิ่งที่พบ <b>Living Atlas</b> ในมือคุณกำลังแสดงการเชื่อมต่อที่แผนที่ทั่วไปไม่มี</p>'+ 
    '<p><b>จุดหมายของคุณคือ Aurelian</b> หลักนำทางของ Wonderhaven เริ่มจากเชื่อมเกาะข้างหน้า: สะพานที่คุณขีดพาได้ทั้งคนและแสง ลองเดินตามมัน แล้วดูว่าโลกตอบสนองอย่างไร</p>'+ 
    '<p class="fine">เหตุใด Atlas เล่มนี้จึงเห็นต่างจากแผนที่อื่น? เก็บหลักฐานระหว่างทาง โดยยังไม่รีบสรุปว่าเล่มใดถูก</p>'+ 
    '<div class="row"><button class="primary" id="azureStoryGo">เริ่มจาก Azure</button></div>',
    ()=>{$('azureStoryGo').onclick=()=>{closeModal();say('ATLAS','หมุดแรกยังมีแสงอยู่ เปิด Atlas แล้วเชื่อมเส้นทางจาก Azure ไปทาง Basin Gardens',6);};}
  );
}

const storyBaseBegin=begin;
begin=(resume=false)=>{
  let s=resume?readSave():null;
  STORY_ONBOARDING.pendingJoin=s?!!s.lioraJoined:false;
  storyBaseBegin(resume);
  lioraJoined=STORY_ONBOARDING.pendingJoin===true;
  STORY_ONBOARDING.pendingJoin=null;
  if(!lioraJoined)parkLioraForMeeting();
  captionTime=0;$('caption').classList.remove('show');
  refresh();save();
  if(!resume)openAzureStory();
  else if(meetingAvailable())say('ATLAS','สัญญาณในสวนกลับมาแล้ว ลองคุยกับผู้เดินทางที่กำลังตรวจหลักทางอยู่ใกล้ ๆ',5);
};

const storyBaseRefresh=refresh;
refresh=()=>{
  storyBaseRefresh();
  $('companion').hidden=!lioraJoined;
  $('companionstate').hidden=!lioraJoined;
  if(!lioraJoined){
    if(active.has(2)){
      $('chapter').textContent='INTERLUDE / A VOICE IN BASIN GARDENS';
      $('objective').textContent='พบผู้เดินทางที่ Basin Gardens';
      $('objectivehint').textContent='เข้าใกล้ Liora แล้วกด E เพื่อคุย';
    }else{
      $('companionstate').textContent='';
    }
  }
};

function openLioraEncounter(){
  if(lioraJoined||!active.has(2))return;
  openModal('LIORA — เสียงหนึ่งใน Basin Gardens',
    '<p>เมื่อสัญญาณในสวนกลับมา คุณพบผู้เดินทางกำลังเปรียบเทียบเครื่องหมายบนหลักทางกับสมุดของเธอ เธอแนะนำตัวว่า Liora</p>'+ 
    '<p><b>LIORA</b> — “เธอเชื่อมสะพานนั้นเองหรือ? บันทึกของฉันไม่มีทางเส้นนี้ แต่สัญญาณตอบสนองจริง เราควรจดทั้งสองอย่างไว้”</p>'+ 
    '<p>เธอมอง Atlas ในมือคุณ แล้วเปิดหน้าที่บันทึกเส้นทางมุ่งสู่ Aurelian</p>'+ 
    '<p><b>LIORA</b> — “ฉันกำลังตรวจเครื่องหมายที่ผู้เดินทางใช้กันแถวนี้ ถ้าเธอมุ่งหน้าไป Aurelian เราไปดูทางข้างหน้าด้วยกันได้ ฉันรู้จักกลไกบางอย่างที่นั่น”</p>'+ 
    '<div class="row"><button class="primary" id="joinLiora">ชวน Liora ร่วมเดินทาง</button><button class="secondary" data-close>ค่อยคุยอีกที</button></div>',
    ()=>{$('joinLiora').onclick=()=>{joinLiora();};}
  );
}
function joinLiora(){
  if(lioraJoined)return;
  lioraJoined=true;liora.hold=false;liora.command='follow';liora.moving=0;V2.command='follow';V2.nav=[];V2.navAge=0;V2.navEpoch++;
  closeModal();refresh();save();
  say('LIORA','ไปกันเถอะ เธอเชื่อมทาง ส่วนฉันจะช่วยอ่านเครื่องหมาย ถ้าเราเห็นไม่ตรงกัน ลองตรวจจากพื้นที่จริงด้วยกัน',6);
}

const storyBaseInteraction=interaction;
interaction=()=>{
  if(meetingAvailable()&&dist(player,liora)<92)return {label:'E · คุยกับ Liora',action:openLioraEncounter};
  let a=storyBaseInteraction();
  if(!lioraJoined&&a){
    if(a.label==='E · ฟัง Liora')return {label:'E · ตรวจ Atlas',action:()=>say('ATLAS','Aurelian อยู่ไกลออกไปทางเหนือ แต่เส้นทางแรกต้องเริ่มจากหมุดที่ Azure',5)};
    if(a.label.includes('Liora')){
      if(onIsland(player)?.kind==='plate')return {label:'E · เปิดประตูกระจก 12 วินาที',action:()=>{gateTimer=12;say('ATLAS','ประตูกระจกเปิดชั่วคราว 12 วินาที',4);tone(340,.3);}};
      return null;
    }
  }
  return a;
};

const storyBaseCompanion=companion;
companion=()=>{if(!lioraJoined){say('ATLAS',active.has(2)?'เข้าไปคุยกับผู้เดินทางที่ Basin Gardens ก่อน':'ตอนนี้คุณยังเดินทางเพียงลำพัง',3);return;}return storyBaseCompanion();};
$('companion').onclick=companion;

const storyBaseMoveLiora=moveLiora;
moveLiora=dt=>{if(!lioraJoined){liora.moving=0;if(active.has(2))parkLioraForMeeting();return;}storyBaseMoveLiora(dt);};

const storyBaseCanRemove=canRemove;
canRemove=(b,replacement=null)=>{
  if(lioraJoined)return storyBaseCanRemove(b,replacement);
  if(actorOnLink(player,b)){say('ATLAS','เดินถึงเกาะก่อน สะพานเส้นนี้ยังรองรับคุณอยู่',4);return false;}
  return true;
};

const storyBaseRescue=rescue;
rescue=reason=>{
  if(lioraJoined)return storyBaseRescue(reason);
  storyBaseRescue(reason);
  parkLioraForMeeting();
  say('ATLAS',reason||'Atlas พาคุณกลับถึงหลักแสงแล้ว',4);
  refresh();save();
};

const storyBaseAddBridge=addBridge;
addBridge=(a,b)=>{let before=weaves,ok=storyBaseAddBridge(a,b);if(ok&&!lioraJoined&&before===0)say('ATLAS','สะพานพร้อมแล้ว ปิด Atlas แล้วเดินขึ้นไปบนเส้นที่คุณวาดได้เลย',5);return ok;};

const storyBaseActivate=activate;
activate=id=>{
  let ok=storyBaseActivate(id);
  if(ok&&id===2&&!lioraJoined){
    parkLioraForMeeting();
    say('ATLAS','สัญญาณในสวนตอบสนองแล้ว… มีผู้เดินทางกำลังตรวจหลักทางอยู่ใกล้ ๆ',6);
    refresh();save();
  }
  return ok;
};

const storyBasePropOccludes=propOccludes;
propOccludes=(i,c)=>{if(c===liora&&!lioraJoined&&!active.has(2))return false;return storyBasePropOccludes(i,c);};

const storyBaseRenderCharacter=renderCharacter;
renderCharacter=(c,isLiora=false)=>{
  if(isLiora&&!lioraJoined&&!active.has(2))return;
  storyBaseRenderCharacter(c,isLiora);
  if(isLiora&&!lioraJoined&&active.has(2)&&!atlas){let p=worldToScreen(c.x,c.y,34),s=camera.z;ctx.save();ctx.shadowBlur=8;ctx.shadowColor='#9cf0d8';label('Liora',p.x,p.y-18*s,11,'#baf3df');ctx.restore();}
};

// Suppress the old text label “คุณ”; the player marker now identifies itself by shape and motion alone.
const storyBaseLabel=label;
label=(text,...args)=>{if(atlas&&text==='คุณ')return;return storyBaseLabel(text,...args);};

const storyBaseToggleAtlas=toggleAtlas;
toggleAtlas=()=>{
  storyBaseToggleAtlas();
  if(atlas){$('atlashint').textContent='ลากหมุด / แตะ 2 จุด';$('atlasdetail').textContent=bridges.length===3?'เส้นประ = เส้นที่จะถูกแทน · Q ปิด':'3 สะพาน · Q ปิด Atlas';}
};
$('atlas').onclick=toggleAtlas;

const storyBaseRender=render;
render=()=>{
  storyBaseRender();
  if(atlas&&started){
    let p=worldToScreen(player.x,player.y),t=performance.now()/1000,pulse=(Math.sin(t*2.4)+1)/2;
    ctx.save();ctx.globalCompositeOperation='source-over';
    // Two low-alpha ripples read at a glance without becoming a flashing beacon.
    ctx.globalAlpha=.22*(1-pulse)+.06;circle(p.x,p.y,28+pulse*11,null,'#fff2ad',2.2);
    ctx.globalAlpha=.12*(pulse)+.04;circle(p.x,p.y,38+(1-pulse)*9,null,'#9df0da',1.5);
    ctx.globalAlpha=1;ctx.shadowBlur=18;ctx.shadowColor='#ffe7a0';
    // Cardinal ticks + large diamond distinguish Wayfinder from circular anchors.
    line(p.x,p.y-28,p.x,p.y-20,'#fff1b0',2.4);line(p.x+28,p.y,p.x+20,p.y,'#fff1b0',2.4);line(p.x,p.y+28,p.x,p.y+20,'#fff1b0',2.4);line(p.x-28,p.y,p.x-20,p.y,'#fff1b0',2.4);
    path([[p.x,p.y-16],[p.x+12,p.y],[p.x,p.y+16],[p.x-12,p.y]],'#082d34','#fff4bd',3);
    path([[p.x,p.y-8],[p.x+6,p.y],[p.x,p.y+8],[p.x-6,p.y]],'#f1cf78','#fff6cc',1.5);
    circle(p.x,p.y,2.6,'#fff8db');ctx.restore();
  }
};

const storyBaseShowHelp=showHelp;
showHelp=()=>{
  if(lioraJoined)return storyBaseShowHelp();
  openModal('เส้นทางเกิดจากมือคุณ','<p>พาแสงผ่านสะพานที่คุณขีด ไปปลุกสถานที่ที่ดับลง แล้วเดินทางไปถึงด้วยตัวเอง</p><div class="helpgrid"><b>WASD / จอย</b><span>เดินบนเกาะและสะพาน</span><b>Q / ขีดสะพาน</b><span>เปิด Atlas → ลากหมุด หรือแตะต้นทางและปลายทาง → ปิด Atlas แล้วเดินข้าม</span><b>3 เส้น</b><span>เส้นที่ 4 จะแทนเส้นเก่าที่สุด ดูเส้นประก่อนยืนยัน</span><b>Space / พุ่ง</b><span>พุ่งตามทิศที่เดิน ใช้ผ่านจังหวะอันตรายและช่องว่างสั้น ๆ</span><b>E / ใช้งาน</b><span>ปลุกหลักแสง เก็บความทรงจำ หรือใช้กลไกที่อยู่ใกล้</span></div><p class="fine">ระหว่างทางคุณอาจพบคนและความทรงจำที่เปลี่ยนวิธีเดินทางต่อไป</p><div class="row"><button class="primary" data-close>กลับไปผจญภัย</button></div>');
};
$('help').onclick=showHelp;

// Re-evaluate Continue after installing v3 save compatibility.
$('continue').hidden=!readSave();
refresh();
