function power(){let p=new Set([0]),changed=true;while(changed){changed=false;for(let b of S.bridges){let a=b.a,c2=b.b;if(a===1||c2===1)continue;if(p.has(a)&&!p.has(c2)){p.add(c2);changed=true;}if(p.has(c2)&&!p.has(a)){p.add(a);changed=true;}}}// source may enter relay only through a bridge
