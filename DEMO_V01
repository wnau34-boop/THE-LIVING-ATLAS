  [...set.children].forEach((el,i)=>{el.className='mapSpark '+(i<map1Sparks?'on':'off');if(i===lostIndex)el.classList.add('lost');});
}
paintMap1Sparks();

function updateMap2Launch(){
  const launch=document.getElementById('relayLaunch');if(!launch)return;
  launch.textContent='บททดสอบ · Whisperglass Relay';
  launch.title='ปลดล็อกเมื่อจบเส้นทางต้นแบบ';
  launch.hidden=!map2Unlocked();
  launch.onclick=()=>openMap2Intro();
}

function tuneRelayAsMap2(){
  const brand=document.querySelector('#relayScene .relayBrand small');if(brand)brand.textContent='WHISPERGLASS RELAY · บททดสอบ';
  const ey=document.querySelector('#relayScene .relayObjective .ey');if(ey)ey.textContent='RELAY / แสงสองทิศ';
  const hint=document.getElementById('relayHint');if(hint)hint.textContent='แสงในรอยแยกถูกหักออกเป็นสองทิศ · อ่านพื้นที่ก่อนเลือกทางของคุณ';
}

function openMap2Intro(){
  if(!map2Unlocked())return;
  openModal('Whisperglass Relay — บททดสอบแสง',
    '<div class="mapProgressTag">Whisperglass Relay · บททดสอบแยก</div>'+ 
    '<p>ใน <b>Whisperglass Relay</b> สะพานชุดเดียวกันเป็นทั้งทางเดินและทางส่งแสง ลองจัดการเชื่อมต่อเพื่อพาสัญญาณไปถึงปลายทาง</p>'+ 
    '<p>ในด่านนี้คุณจะใช้สิ่งที่เรียนจาก MAP 1 แล้วเจอกฎใหม่ทีละชั้น: <b>Prism Relay</b> ซึ่งเป็นอุปกรณ์สับทิศแสง, เส้นทางที่ปลอดภัยหรือเสี่ยงกว่า, จังหวะ <b>Glasswind</b> และการประสานกับ Liora</p>'+ 
    '<p class="fine">ฉากนี้เป็นบททดสอบกลไก ไม่ใช่ MAP 2 ของเรื่องราว Wonderhaven ฉบับใหม่</p>'+ 
    '<div class="row"><button class="primary" id="enterMap2Now">เล่นบททดสอบ Relay</button><button class="secondary" data-close>ยังไม่ไป</button></div>',
    ()=>{const b=document.getElementById('enterMap2Now');if(b)b.onclick=()=>{closeModal();tuneRelayAsMap2();window.WB_RELAY?.open();};}
  );
}

function restartMap1(){
  // Explicit menu/debug restart only. Fracture recovery never calls this.
  map1FractureOpen=false;map1EndingShown=false;map1Sparks=3;map1Fractures=0;saveMap1Sparks();saveMap1Fractures();paintMap1Sparks();
  try{safeStoreRemove(V2.key);safeStoreRemove(KEY);}catch(e){}
  closeModal();
  begin(false);
}
function map1LandmarkName(){const i=islands[checkpoint]||islands[0];return i?.name||'หลักแสงล่าสุด';}
function recoverMap1FromFracture(){
  const i=islands[checkpoint]||islands[0];
  map1FractureOpen=false;map1Sparks=3;saveMap1Sparks();paintMap1Sparks();
  bridges=[];selected=null;gateTimer=0;bridgeFail=0;dashTime=0;dashCooldown=.35;safeTime=2;trail=[];keys={};clearInput?.();
  player.x=i.x;player.y=i.y+55;player.moving=0;
  liora.hold=false;liora.command='follow';
  try{V2.nav=[];V2.navAge=0;V2.navEpoch++;}catch(e){}
  if(typeof lioraJoined!=='undefined'&&lioraJoined){liora.x=i.x-30;liora.y=i.y+70;}else if(typeof parkLioraForMeeting==='function'){parkLioraForMeeting();}
  closeModal();shake=5;spawn(player.x,player.y,35,'#a0ede2',1.1);refresh();save();
  const who=(typeof lioraJoined!=='undefined'&&lioraJoined)?'LIORA':'ATLAS';
  say(who,`ATLAS REMEMBERS · กลับสู่ ${i.name} · Atlas Sparks กลับมา 3 ดวง`,5);
}
function fractureMap1(){
  if(map1FractureOpen)return;map1FractureOpen=true;map1Fractures++;saveMap1Fractures();rescues++;clearInput?.();
  const landmark=map1LandmarkName();
  openModal('ATLAS FRACTURED',
    '<div class="mapProgressTag">FAIL FORWARD · โลกที่ฟื้นแล้วจะไม่ถูกลบ</div>'+ 
    '<p>Atlas Sparks ดับครบทั้งสามดวง แต่สถานที่ ความทรงจำ และเรื่องราวที่คุณฟื้นกลับมาแล้ว <b>ยังคงอยู่</b></p>'+ 
    '<p>Atlas จะดึงคุณกลับสู่ <b>'+landmark+'</b> คืน Sparks 3 ดวง และรีเซ็ตเฉพาะสะพานกับกลไกชั่วคราวของช่วงที่กำลังลอง</p>'+ 
    '<p class="fine">ATLAS REMEMBERS · การแตกสลายครั้งนี้จะถูกจดจำเป็น Fracture Echo แต่ไม่ลดพลังหรือปิดกั้นเนื้อหา</p>'+ 
    '<div class="row"><button class="primary" id="recoverMap1Now">กลับสู่หลักแสงล่าสุด</button></div>',
    ()=>{document.getElementById('recoverMap1Now').onclick=recoverMap1FromFracture;}
  );
}

const flowBaseBegin=begin;
begin=(resume=false)=>{
  map1FractureOpen=false;map1EndingShown=false;
  map1Sparks=resume?loadMap1Sparks():3;map1Fractures=resume?loadMap1Fractures():0;
  if(!resume){saveMap1Sparks();saveMap1Fractures();}
  const r=flowBaseBegin(resume);paintMap1Sparks();updateMap2Launch();return r;
};

const flowBaseRescue=rescue;
rescue=reason=>{
  // Manual "return to checkpoint" is a utility action, not a life loss.
  if(typeof reason==='string'&&reason.includes('กลับมาถึงหลักแสงแล้ว'))return flowBaseRescue(reason);
  if(!started||map1FractureOpen||finished&&active.has(9))return flowBaseRescue(reason);
  const before=map1Sparks;
  map1Sparks=Math.max(0,map1Sparks-1);saveMap1Sparks();paintMap1Sparks(before-1);
  if(map1Sparks<=0){fractureMap1();return;}
  flowBaseRescue(reason);
  const who=(typeof lioraJoined!=='undefined'&&lioraJoined)?'LIORA':'ATLAS';
  say(who,`${reason||'Atlas ดึงคุณกลับจากขอบฟ้า'} · Atlas Sparks เหลือ ${map1Sparks} ดวง`,4.5);
};

// MAP 1 is the entire original journey. Completion happens only after Aurelian awakens.
ending=()=>{
  if(map1EndingShown)return;map1EndingShown=true;
  try{V2.cinematicSeen=true;}catch(e){} winTime=8; finished=true; setMap2Unlocked(); save();
  const lm=(window.WB_LIGHT_MARKS&&window.WB_LIGHT_MARKS.status)?window.WB_LIGHT_MARKS.status():{found:0,total:islands.length,complete:false};
  const lightMarkNote=lm.complete?'ค้นพบครบแล้วใน MAP 1':'ยังเหลืออีก '+Math.max(0,lm.total-lm.found)+' แห่ง';
  openModal('บันทึกการเดินทาง — เส้นทางต้นแบบ',
    '<img class="endart" src="'+ART[8]+'" alt="Landmark และกลุ่มเกาะของ Wonderhaven">'+
    '<div class="mapProgressTag">AZURE → BASIN GARDENS → WHISPERGLASS → SUN LENS → AURELIAN</div>'+ 
    '<p>สัญญาณที่ Aurelian ตอบรับเส้นทางที่คุณเชื่อม นี่คือบันทึกการเดินทางใน <b>เส้นทางต้นแบบ</b> พร้อมร่องรอยและ Chronicle ที่คุณพบด้วยตัวเอง</p>'+ 
    '<p>'+(found.has(2)?'โคมจากท่าเรือยังส่องอยู่ไกลออกไป บันทึกของผู้ดูแลเตือนว่าเส้นทางหนึ่งมีความหมายต่อผู้เดินทางมากกว่าคนเดียว':'รอยแสงบน Atlas บันทึกสิ่งที่คุณเชื่อม ส่วนช่องว่างที่เหลือยังรอการสำรวจ')+'</p>'+ 
    '<div class="stats map1SummaryStats">'+
      '<div><b>'+found.size+' / 4</b><span class="statLabel">เรื่องราวที่พากลับมา</span><small class="statNote">ความทรงจำที่ค้นพบและบันทึกไว้ใน Chronicle</small></div>'+ 
      '<div class="lightMarkStat"><b>'+lm.found+' / '+lm.total+'</b><span class="statLabel">รอยแสงที่ค้นพบ</span><small class="statNote '+(lm.complete?'complete':'')+'">'+lightMarkNote+'</small></div>'+ 
      '<div><b>'+weaves+'</b><span class="statLabel">สะพานที่คุณขีด</span><small class="statNote">จำนวนครั้งที่วาดสะพานสำเร็จตลอด MAP 1</small></div>'+ 
      '<div><b>'+map1Fractures+'</b><span class="statLabel">Fracture Echo</span><small class="statNote">จำนวนครั้งที่ Atlas ต้องดึงคุณกลับสู่หลักแสง</small></div>'+ 
      '<div><b>'+Math.floor(elapsed/60)+':'+String(Math.floor(elapsed%60)).padStart(2,'0')+'</b><span class="statLabel">เวลา MAP 1</span><small class="statNote">เวลาที่ใช้ในการเดินทางครั้งนี้</small></div>'+ 
    '</div>'+ 
    '<p class="fine"><b>รอยแสง</b> คือร่องรอยของเส้นทางเดิมที่ Atlas บันทึกเมื่อคุณไปถึงสถานที่ใหม่ในแผนที่</p>'+ 
    '<p class="fine">'+(map1Fractures===0?'UNBROKEN JOURNEY · Atlas ไม่เคยต้องดึงเส้นทางกลับ':'ATLAS REMEMBERS · การเดินทางนี้เคยแตกสลาย '+map1Fractures+' ครั้ง แต่สิ่งที่ฟื้นแล้วไม่เคยหายไป')+'</p>'+ 
    '<p><b>Atlas เก็บทั้งเส้นทางที่คุณเดินและคำถามที่ยังตอบไม่ได้</b> ร่องรอยในหน้าบันทึกยังไม่ตรงกับแผนที่ที่คุณใช้ตอนออกเดินทาง</p>'+ '<p><b>LIORA</b> — “เก็บบันทึกหน้านี้ไว้ เราอาจพบหลักฐานเพิ่มระหว่างทาง”</p>'+ '<div class="mapUnlock"><p><b>ปลดล็อกบททดสอบ — Whisperglass Relay</b><br>ทดลองจัดเส้นทางและทิศแสงในฉาก Relay แยกจากเรื่องราวหลัก</p></div>'+ 
    '<div class="row"><button class="primary" id="map1ToMap2">เล่นบททดสอบ Relay</button><button class="secondary" id="map1Explore">กลับไปสำรวจ MAP 1</button><button class="secondary" id="map1Journal">เปิด Chronicle</button></div>',
    ()=>{
      document.getElementById('map1ToMap2').onclick=()=>{closeModal();openMap2Intro();};
      document.getElementById('map1Explore').onclick=()=>closeModal();
      document.getElementById('map1Journal').onclick=journal;
    }
  );
};

// Player-facing Relay entry is a real next-map unlock, never an early experiment shortcut.
updateMap2Launch();tuneRelayAsMap2();
window.WB_MAP_FLOW={version:FLOW.version,get map1Sparks(){return map1Sparks;},get map1Fractures(){return map1Fractures;},get map2Unlocked(){return map2Unlocked();},openMap2:openMap2Intro,restartMap1,recoverFromFracture:recoverMap1FromFracture,debugLoseSpark(){rescue('DEBUG FALL');}};
})();
</script>


