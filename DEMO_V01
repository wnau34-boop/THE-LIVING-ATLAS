function adj(bridges=S.bridges){let A=Array.from({length:nodes.length},()=>[]);for(let b of bridges){A[b.a].push(b.b);A[b.b].push(b.a);}return A;}
function path(from,to,bridges=S.bridges){if(from==null||to==null)return null;if(from===to)return[from];let A=adj(bridges),q=[from],prev=new Map([[from,-1]]);while(q.length){let u=q.shift();for(let v of A[u])if(!prev.has(v)){prev.set(v,u);if(v===to){let r=[v],k=u;while(k>=0){r.push(k);k=prev.get(k);}return r.reverse();}q.push(v);}}return null;}
function actorSafe(actor,bridges){let n=actorNodeWith(actor,bridges);if(n==null)return false;for(let s of SAFE)if(path(n,s,bridges))return true;return false;}
function actorNodeWith(a,bridges){let n=nodes.find(n=>d(a,n)<n.r+5);if(n)return n.id;let b=bridges.find(b=>lineDist(a,nodes[b.a],nodes[b.b]).d<HALF);if(!b)return null;return d(a,nodes[b.a])<d(a,nodes[b.b])?b.a:b.b;}
function onLink(actor,b){return !nodeAtWorld(actor)&&lineDist(actor,nodes[b.a],nodes[b.b]).d<HALF+5;}
function validateBridge(a,b){if(!Number.isInteger(a)||!Number.isInteger(b)||!nodes[a]||!nodes[b]||a===b)return{ok:false,msg:'หมุดไม่ถูกต้อง'};if(d(nodes[a],nodes[b])>MAX)return{ok:false,msg:'ไกลเกินเส้นเดียว · ใช้เกาะกลาง'};if(S.bridges.some(x=>(x.a===a&&x.b===b)||(x.a===b&&x.b===a)))return{ok:false,msg:'หมุดคู่นี้เชื่อมแล้ว'};let next=S.bridges.map(x=>({...x}));if(next.length===3){let old=next[0];if(onLink(S.player,old)||onLink(S.liora,old))return{ok:false,msg:'มีคนอยู่บนเส้นที่จะถูกแทน'};next.shift();}next.push({a,b});if(!actorSafe(S.player,next)||!actorSafe(S.liora,next))return{ok:false,msg:'Atlas ปฏิเสธ: หลังเปลี่ยนต้องยังถึง safe anchor ได้'};return{ok:true,next};}
