const updateBase=update;update=dt=>{if(!run)loadRun();if(started&&!paused&&atlas){const d=Math.max(0,Number(dt)||0);run.atlasTimeSec+=d;atlasPersistAge+=d;if(atlasPersistAge>=2){atlasPersistAge=0;persist();}}return updateBase(dt);};

window.WB_MAP1_SCORE={version:F53.version,scoringVersion:F53.scoringVersion,activeKey:F53.activeKey,boardKey:F53.boardKey,weights:{...F53.weights},metrics,showSummary,timeScore:timePct,get activeRun(){return JSON.parse(JSON.stringify(run||loadRun()));},getLocalLeaderboard(){return JSON.parse(JSON.stringify(sortBoard(loadBoard())));},clearLocalLeaderboard(){try{localStorage.removeItem(F53.boardKey);}catch(e){}}};
