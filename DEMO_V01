<script id="wb-map2-content-proof-v1-script">
(()=>{
'use strict';
const MAP2={version:'map2-content-proof-v1'};
let map2Active=false,lastPhase=-1,lastRestored=false;
const oldOpen=window.WB_RELAY?.open;
if(!oldOpen)return;
const nodes=window.WB_RELAY.nodes;
// Lore-facing labels; numeric ids remain internal only.
const nodeNames=['ทางเข้าสู่รอยแยก','Prism Relay','High Mirrorwalk','Resonance Gate','Echo Nook','Whisperglass Heart'];
nodeNames.forEach((name,i)=>{if(nodes[i])nodes[i].name=name;});
const obj=document.querySelector('#relayScene .relayObjective');
if(obj&&!obj.querySelector('.relayMapChapter')){
  const prog=document.createElement('div');prog.className='relayMapChapter';prog.innerHTML='<i></i><i></i><i></i><i></i>';obj.appendChild(prog);
}
function dist(a,b){return Math.hypot(a.x-b.x,a.y-b.y)}
function phaseFor(s,p){
  if(s.restored)return 4;
  if(!p.has(1))return 0;
  if((s.switches||0)<1)return 1;
  if(!p.has(5))return 2;
  return 3;
}
function setChapter(n){document.querySelectorAll('#relayScene .relayMapChapter i').forEach((el,i)=>el.classList.toggle('on',i<=Math.min(3,n)));}
function applyNarrativeUI(){
  if(!map2Active||document.getElementById('relayScene')?.hidden)return;
  const s=window.WB_RELAY.state,p=window.WB_RELAY.power(),phase=phaseFor(s,p);
  const objective=document.getElementById('relayObjective'),hint=document.getElementById('relayHint'),status=document.getElementById('relayStatus');
  setChapter(phase);
  if(phase===0){
    objective.textContent='พาแสงไปถึง Prism Relay';
    hint.textContent='เริ่มจากกฎที่คุ้นเคย: วาดทาง เดินบนสิ่งที่วาด และพาแสงไปพร้อมกัน';
  }else if(phase===1){
    objective.textContent='ทำความเข้าใจแสงที่แตกเป็นสองทิศ';
    hint.textContent='เข้าใกล้ Prism Relay แล้วสับทิศแสงหนึ่งครั้ง · ดูสิ่งที่เปลี่ยนในโลกก่อนวาดต่อ';
  }else if(phase===2){
    objective.textContent='เลือกทางไปยัง Whisperglass Heart';
    if(s.mode==='A')hint.textContent='ทางสูงเงียบกว่าและปล่อยให้ Liora เดินตามคุณได้ · แต่ต้องยอมเดินไกลกว่า';
    else if(!s.liora.hold)hint.textContent='Resonance Gate สั้นกว่า · ต้องมี Liora ช่วยค้างกลไก';
    else hint.textContent='Liora ค้าง Resonance Gate แล้ว · อ่านจังหวะ Glasswind ก่อนเดินช่วงสุดท้าย';
  }else if(phase===3){
    objective.textContent='ปลุก Whisperglass Heart';
    hint.textContent='แสงมาถึงแล้ว · ไปถึง Whisperglass Heart ด้วยตัวเองและปลุกมัน';
  }else{
    objective.textContent='Whisperglass Heart ฟื้นแล้ว';
    hint.textContent='การเลือกของคุณเปลี่ยนวิธีที่แสงกลับมาหาโลก';
  }
  if(status){
    const route=s.mode==='A'?'High Mirrorwalk':'Resonance Gate';
    status.textContent=`${route} · สะพาน ${s.bridges.length} / 3`+(s.memory?' · พบ Echo Nook':'');
  }
  if(phase!==lastPhase){
    lastPhase=phase;
    const lines=[
      ['LIORA','หน้ากระจกตรงนั้นรับสัญญาณจากหลักแสงทางเข้า ลองพาแสงไปหา Prism Relay'],
      ['LIORA','มันไม่ได้สร้างแสงเพิ่ม… มันแค่เลือกว่าจะส่งแสงที่มีอยู่ไปทางไหน'],
      ['LIORA','สองทางนี้ไปถึงที่เดียวกัน แต่ขอให้เราเลือกสิ่งที่ยอมเสี่ยงเอง'],
      ['ATLAS','Whisperglass Heart พร้อมรับแสง'],
      ['LIORA','เห็นไหม? ทางที่เราเลือกยังอยู่ในแสงของมัน']
    ];
    const [sp,tx]=lines[phase];
    const speaker=document.getElementById('relaySpeaker'),speech=document.getElementById('relaySpeech'),toast=document.getElementById('relayToast');
    if(speaker&&speech&&toast){speaker.textContent=sp;speech.textContent=tx;toast.classList.add('show');setTimeout(()=>toast.classList.remove('show'),3300);}
  }
  if(s.restored&&!lastRestored){lastRestored=true;finishCard(s);}
}
function finishCard(s){
  const card=document.getElementById('relayResult'); if(!card)return;
  const eyebrow=card.querySelector('.eyebrow'),h2=card.querySelector('h2'),p=document.getElementById('relayResultText');
  if(eyebrow)eyebrow.textContent='RELAY COMPLETE · แสงที่แยกออก';
  if(h2)h2.textContent='Whisperglass Heart ตื่นขึ้น';
  const route=s.route==='A'?'High Mirrorwalk':'Resonance Gate';
  const choice=s.route==='A'?'คุณเลือกความมั่นคงและยอมเดินไกลกว่า':'คุณเลือกทางที่เร็วกว่า และยอมประสานจังหวะกับ Liora พร้อมอ่าน Glasswind';
  if(p)p.innerHTML=`<b>${route}</b><br>${choice}<br><br>${s.memory?'Echo Nook สว่างตามขึ้นมา — Atlas บันทึกทั้งจุดหมายและการตัดสินใจที่พาคุณย้อนกลับไปหา':'ยังมี Echo Nook แห่งหนึ่งในแผนที่นี้ที่คุณอาจยังไม่ได้สำรวจ'}`;
}
function showFullIntro(){
  openModal('Whisperglass Relay — บททดสอบแสง',
    '<div class="mapProgressTag">Whisperglass Relay · บททดสอบแยก</div>'+ 
    '<div id="map2IntroFlavor"><b>สะพานหนึ่งเส้น พาได้ทั้งคนและแสง</b><br><b>Whisperglass Relay</b> เป็นบททดสอบที่ให้คุณเลือกทิศทางของสัญญาณ แล้วเดินตามทางที่จัดไว้</div>'+ 
    '<p>เป้าหมายคือส่งแสงและเดินไปถึง <b>Whisperglass Heart</b> ลองใช้ทางสูง หรือประสานกับ Liora เพื่อผ่านประตูกระจก ฉากนี้แยกจากลำดับเรื่องราวหลัก</p>'+ 
    '<div class="map2RuleCards"><div><b>กฎเดิม</b>สะพานยังเป็นทั้งทางเดินและทางส่งแสง</div><div><b>กฎใหม่</b><b>Prism Relay</b> เป็นอุปกรณ์สับทิศแสงและส่งแสงออกได้ทีละทาง</div><div><b>การเลือก</b>เส้นทางหนึ่งสงบกว่า อีกเส้นทางสั้นกว่าแต่ต้องประสานกับ Liora และอ่านจังหวะลม</div></div>'+ 
