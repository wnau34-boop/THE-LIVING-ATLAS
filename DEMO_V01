   }
   if(!goal){
     if(current.id===targetNode){
       if(S.liora.command==='plate')goal=nodes[3];else goal=S.player;
     }else{
       let route=path(current.id,targetNode);if(!route||route.length<2){S.liora.moving=false;return;}
