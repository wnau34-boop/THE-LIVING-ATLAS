if(!['near','standard','far'].includes(layout.rightEdge))layout.rightEdge='far';
if(!['narrow','standard','wide'].includes(layout.rightGap))layout.rightGap='wide';
if(!['low','standard','high'].includes(layout.rightHeight))layout.rightHeight='standard';

function saveLayout(){try{localStorage.setItem(UX4.layoutKey,JSON.stringify(layout));}catch(e){}}
function applyLayout(){
  const b=document.body;
  [...b.classList].filter(c=>c.startsWith('touch-right-edge-')||c.startsWith('touch-right-gap-')||c.startsWith('touch-right-height-')).forEach(c=>b.classList.remove(c));
