<script id="wb-summary-lightmark-v1-script">
(()=>{
'use strict';
const LM={version:'summary-lightmark-v1',key:'wonderbound_map1_light_marks_v1',memoryIslands:[4,6,10,11]};
let lightMarks=new Set();
function validMark(n){return Number.isInteger(n)&&n>=0&&n<islands.length;}
function loadMarks(){
  try{const raw=JSON.parse(localStorage.getItem(LM.key)||'[]');lightMarks=new Set(Array.isArray(raw)?raw.filter(validMark):[]);}catch(e){lightMarks=new Set();}
}
function saveMarks(){try{localStorage.setItem(LM.key,JSON.stringify([...lightMarks].sort((a,b)=>a-b)));}catch(e){}}
function addMark(id){if(!validMark(id)||lightMarks.has(id))return false;lightMarks.add(id);saveMarks();return true;}
function deriveMarksFromProgress(){
  // รอยแสง = ร่องรอยที่ Atlas บันทึกเมื่อผู้เล่นไปถึงสถานที่ใหม่ ไม่ใช่เงินหรือคะแนน
  addMark(0);
  try{for(const id of visited)addMark(id);}catch(e){}
  // Backfill saves created before this tracking layer from required progression.
  try{if(active.has(2)){addMark(1);addMark(2);}if(active.has(5)){addMark(4);addMark(5);}if(active.has(9)){addMark(7);addMark(8);addMark(9);}}catch(e){}
  try{for(const mem of found){const id=LM.memoryIslands[mem];if(validMark(id))addMark(id);}}catch(e){}
  try{addMark(checkpoint);}catch(e){}
  try{const here=onIsland(player);if(here)addMark(here.id);}catch(e){}
}
function status(){deriveMarksFromProgress();return{found:lightMarks.size,total:islands.length,complete:lightMarks.size>=islands.length,ids:[...lightMarks].sort((a,b)=>a-b)};}
loadMarks();deriveMarksFromProgress();
const lightMarkBaseBegin=begin;
begin=(resume=false)=>{
  if(!resume){lightMarks=new Set([0]);saveMarks();}else loadMarks();
  const r=lightMarkBaseBegin(resume);deriveMarksFromProgress();return r;
};
const lightMarkBaseUpdate=update;
update=(dt)=>{
  const r=lightMarkBaseUpdate(dt);
  if(started&&!atlas){try{const here=onIsland(player);if(here)addMark(here.id);}catch(e){}}
  return r;
};
window.WB_LIGHT_MARKS={version:LM.version,status,get found(){return status().found;},get total(){return islands.length;},get complete(){return status().complete;},get ids(){return status().ids;},debugCollectAll(){for(const i of islands)addMark(i.id);return status();}};
})();
</script>


<!-- MAP 1 F2 ROUTE / EVENT ALIGNMENT CANDIDATE V1 -->
<script id="wb-map1-f2-route-event-v1-script">
(()=>{
'use strict';

const F2_ROUTE={
  version:'map1-f2-route-event-v1',
  key:'wonderbound_living_atlas_map1_f2_v1',
  lockedAnchors:new Set([9])
};
let f2WillowReached=false;
let f2Visited=new Set([0]);

// F2 repurposes the existing island geometry instead of rebuilding the map.
// Mechanics that belong to later maps remain in source but are removed from MAP 1's playable flow.
Object.assign(islands[4],{name:'Broken Crossing',th:'ทางข้ามที่ขาดช่วง',kind:'step'});
Object.assign(islands[5],{name:'Meadow Relay',th:'หลักสัญญาณกลางทุ่ง',kind:'beacon'});
Object.assign(islands[7],{name:'Willow Approach',th:'ทางผ่านสู่ Willow Road',kind:'step'});
Object.assign(islands[8],{name:'Willow Road',th:'เส้นทางริมหลิว',kind:'step'});
Object.assign(islands[9],{name:'Distant Horizon',th:'เส้นขอบฟ้าที่ยังไปไม่ถึง',f2Locked:true});

// F2 is solo by design. Liora's real encounter/choice belongs to F3.
lioraJoined=false;
meetingAvailable=()=>false;
moveLiora=()=>{liora.moving=0;liora.hold=false;liora.command='waiting';};
companion=()=>{say('ATLAS','ตอนนี้ Wayfinder ยังเดินทางเพียงลำพัง · เหตุการณ์ของ Liora อยู่ถัดไปที่ Willow Road',3.5);};
$('companion').onclick=companion;

const f2RenderCharacterBase=renderCharacter;
renderCharacter=(c,isLiora=false)=>{if(isLiora)return;return f2RenderCharacterBase(c,false);};
const f2PropOccludesBase=propOccludes;
propOccludes=(i,c)=>c===liora?false:f2PropOccludesBase(i,c);

// Disable prototype-only hazards and lens logic without deleting their implementation.
stormData=()=>[];
lens=0;
gateTimer=0;

function f2Position(p){return p&&Number.isFinite(p.x)&&Number.isFinite(p.y)?{x:p.x,y:p.y}:null;}
function f2Normalize(raw){
  if(!raw||raw.version!==4||!Array.isArray(raw.active)||!Array.isArray(raw.found))return null;
  const a=[0];if(raw.active.includes(2))a.push(2);if(a.includes(2)&&raw.active.includes(5))a.push(5);
  const seen=new Set(),links=[];
  for(const l of Array.isArray(raw.bridges)?raw.bridges:[]){
    if(!l||!Number.isInteger(l.a)||!Number.isInteger(l.b)||!islands[l.a]||!islands[l.b]||l.a===l.b||dist(islands[l.a],islands[l.b])>MAX_LINK)continue;
    if(F2_ROUTE.lockedAnchors.has(l.a)||F2_ROUTE.lockedAnchors.has(l.b))continue;
    const id=[l.a,l.b].sort((x,y)=>x-y).join(':');
    if(!seen.has(id)){seen.add(id);links.push({a:l.a,b:l.b});}
  }
  const cp=a.includes(raw.checkpoint)?raw.checkpoint:a[a.length-1];
  return {
    version:4,active:a,
    found:[...new Set(raw.found.filter(n=>Number.isInteger(n)&&n>=0&&n<4))],
    bridges:links.slice(-3),checkpoint:cp,lens:0,
    elapsed:Math.max(0,Number(raw.elapsed)||0),
    rescues:Math.max(0,Math.floor(Number(raw.rescues)||0)),
    weaves:Math.max(0,Math.floor(Number(raw.weaves)||0)),
    player:f2Position(raw.player),liora:null,lioraJoined:false,hold:false,gateTimer:0,
    cinematicSeen:false,finished:false,
    f2WillowReached:raw.f2WillowReached===true,
    f2Visited:Array.isArray(raw.f2Visited)?raw.f2Visited.filter(n=>Number.isInteger(n)&&n>=0&&n<islands.length):[0]
  };
}
readSave=()=>{
  try{
    const raw=localStorage.getItem(F2_ROUTE.key);
    return raw?f2Normalize(JSON.parse(raw)):null;
  }catch(e){return null;}
};
save=()=>{
  if(!started)return;
  try{
    localStorage.setItem(F2_ROUTE.key,JSON.stringify({
      version:4,active:[...active].filter(n=>[0,2,5].includes(n)),found:[...found],
      checkpoint:[0,2,5].includes(checkpoint)?checkpoint:0,lens:0,elapsed,rescues,weaves,
      bridges:bridges.filter(b=>!F2_ROUTE.lockedAnchors.has(b.a)&&!F2_ROUTE.lockedAnchors.has(b.b)).map(b=>({a:b.a,b:b.b})),
      player:stable(player)?{x:player.x,y:player.y}:null,
      lioraJoined:false,hold:false,gateTimer:0,cinematicSeen:false,finished:false,
      f2WillowReached,f2Visited:[...f2Visited]
    }));
    $('saveinfo').textContent='บันทึกเส้นทาง MAP 1 · F2 แล้ว';
    $('saveinfo').classList.remove('savewarn');
  }catch(e){
    $('saveinfo').textContent='บันทึกไม่ได้ในเบราว์เซอร์นี้ · ยังเล่นต่อได้';
    $('saveinfo').classList.add('savewarn');
  }
};

const f2RefreshBase=refresh;
refresh=()=>{
  f2RefreshBase();
  $('companion').hidden=true;$('companionstate').hidden=true;
  $('seal2').classList.toggle('on',active.has(2));
  $('seal5').classList.toggle('on',active.has(5));
  $('seal9').classList.toggle('on',f2WillowReached);
  if(f2WillowReached){
    $('chapter').textContent='F2 / WILLOW ROAD REACHED';
    $('objective').textContent='สำรวจร่องรอยที่ Willow Road';
    $('objectivehint').textContent='เส้นทางพร้อมสำหรับเหตุการณ์ช่วยผู้เดินทางในช่วงถัดไปของ MAP 1';
  }else if(active.has(5)){
    $('chapter').textContent='03 / TOWARD WILLOW ROAD';
    $('objective').textContent='ตามเส้นทางไป Willow Road';
    $('objectivehint').textContent='ต่อสะพานจาก Meadow Relay → Willow Approach → Willow Road';
  }else if(active.has(2)){
    $('chapter').textContent='02 / THE BROKEN CROSSING';
    $('objective').textContent='ข้าม Broken Crossing และฟื้น Meadow Relay';
    $('objectivehint').textContent='อ่านระยะของเกาะ แล้วพาแสงจาก Basin Gardens ไปยังหลักสัญญาณ';
  }else{
    $('chapter').textContent='01 / THE FIRST THREAD';
    $('objective').textContent='พาแสงกลับสู่ Basin Gardens';
    $('objectivehint').textContent='Q เปิด Atlas · เชื่อม Azure → Lantern Crossing → Basin Gardens';
  }
};

activate=id=>{
  if(!started||paused||atlas||![2,5].includes(id)||active.has(id)||dist(player,islands[id])>83)return false;
  const i=islands[id],power=powered();
  if(!power.has(id)){say('ATLAS','แสงยังมาไม่ถึง · ต่อสะพานจากจุดที่มีแสงแล้วลองอีกครั้ง',4.5);return false;}
  if(id===5&&!active.has(2)){say('ATLAS','Basin Gardens ยังไม่ฟื้น · ให้เส้นทางแรกกลับมามีแสงก่อน',4.5);return false;}
  active.add(id);checkpoint=id;safeTime=3;shake=4;
  spawn(i.x,i.y,85,'#ffe29c',2.6);waves.push({x:i.x,y:i.y,r:0,life:3});
  tone(261,.7);tone(392,.9,.1);tone(523,1,.2);
  if(id===2)say('ATLAS','Basin Gardens ตอบสนองแล้ว · รอยเส้นทางถัดไปพาดผ่าน Broken Crossing',6);
  if(id===5)say('ATLAS','Meadow Relay ส่งสัญญาณต่อแล้ว · Willow Road อยู่ถัดไปทางเหนือ',6);
  refresh();save();return true;
};

interaction=()=>{
  if(paused||atlas||!started)return null;
  const i=onIsland(player,4);if(!i||dist(player,i)>83)return null;
  if(i.kind==='memory'&&!found.has(i.memory))return{
    label:'E · เก็บเสียงสะท้อน',
    action:()=>{found.add(i.memory);spawn(i.x,i.y,50,'#a4edde',2);say('CHRONICLE · '+memories[i.memory].title,memories[i.memory].text,11);tone(520,.5);tone(780,.7,.15);refresh();save();}
  };
  if(i.id===2&&!active.has(2))return{label:'E · '+(powered().has(2)?'ฟื้น Basin Gardens':'ต้องส่งแสงมาถึงที่นี่ก่อน'),action:()=>activate(2)};
  if(i.id===5&&!active.has(5))return{label:'E · '+(powered().has(5)?'ฟื้น Meadow Relay':'ต้องส่งแสงมาถึงที่นี่ก่อน'),action:()=>activate(5)};
  if(i.id===8)return{
    label:f2WillowReached?'E · อ่านรอยเส้นทาง Willow Road':'E · บันทึก Willow Road',
    action:()=>{if(!active.has(5)){say('ATLAS','รอยเส้นทางยังไม่ต่อเนื่อง · ฟื้น Meadow Relay ก่อน',4);return;}if(!f2WillowReached){f2WillowReached=true;f2Visited.add(8);refresh();save();say('ATLAS','Willow Road ถูกบันทึกแล้ว · มีร่องรอยของผู้เดินทางอยู่ข้างหน้า',6);}else say('ATLAS','รอยทางหลายเส้นมาบรรจบตรงนี้ แต่เหตุการณ์ข้างหน้ายังไม่ถูกเปิดใน F2 candidate',4);}
  };
  if(i.kind==='home')return{label:'E · ตรวจ Living Atlas',action:()=>say('ATLAS','เส้นที่ Atlas เห็นต่างจากแผนที่ทั่วไป · ลองพิสูจน์ด้วยการเดินและแสง',5)};
  return null;
};

const f2AnchorAtBase=anchorAt;
anchorAt=(x,y)=>{
  const hit=f2AnchorAtBase(x,y);
  return hit&&F2_ROUTE.lockedAnchors.has(hit.id)?null:hit;
};

const f2CanRemoveBase=canRemove;
canRemove=(b,replacement=null)=>{
  if(actorOnLink(player,b)){
    say('ATLAS','เดินถึงเกาะก่อน สะพานเส้นนี้ยังรองรับคุณอยู่',4);
    return false;
  }
  // Liora has not joined in F2, so an off-stage companion must never block bridge replacement.
  return true;
};

const f2AddBridgeBase=addBridge;
addBridge=(a,b)=>{
  if(F2_ROUTE.lockedAnchors.has(a)||F2_ROUTE.lockedAnchors.has(b)){
    say('ATLAS','Aurelian ยังเป็นปลายทางไกลของ MAP ถัดไป · เส้นนี้ยังไม่เปิดใน F2',4);
    return false;
  }
  return f2AddBridgeBase(a,b);
};

const f2UpdateBase=update;
update=dt=>{
  const r=f2UpdateBase(dt);
  if(started&&!atlas&&!paused){
    const here=onIsland(player);
    if(here){
      f2Visited.add(here.id);
      if(here.id===8&&active.has(5)&&!f2WillowReached){
        f2WillowReached=true;refresh();save();
        say('ATLAS','คุณมาถึง Willow Road แล้ว · Atlas พบร่องรอยของผู้เดินทางอยู่ถัดไป',6);
      }
    }
  }
  return r;
};

showHelp=()=>{
  openModal('เส้นทางเกิดจากมือคุณ',
    '<p>MAP 1 ใช้กฎเดิม: ขีดสะพาน เดินบนสิ่งที่ขีด และพาแสงไปตามเส้นเดียวกัน</p>'+
    '<div class="helpgrid">'+
    '<b>WASD / จอย</b><span>เดินบนเกาะและสะพาน</span>'+
    '<b>Q / Atlas</b><span>ลากหมุด หรือแตะต้นทางและปลายทางเพื่อสร้างสะพาน</span>'+
    '<b>3 เส้น</b><span>เส้นที่ 4 แทนเส้นเก่าที่สุดเมื่อปลอดภัย</span>'+
    '<b>Space</b><span>พุ่งตามทิศที่เดิน</span>'+
    '<b>E</b><span>ฟื้น Basin Gardens / Meadow Relay และเก็บ Chronicle</span>'+
    '<b>เป้าหมาย F2</b><span>Azure → Basin Gardens → Broken Crossing → Meadow Relay → Willow Road</span>'+
    '</div><p class="fine">Listening Gate, Glasswind และเลนส์รวมแสงถูกพักจาก playable flow ของ MAP 1; ระบบเดิมยังอยู่ใน source สำหรับ Map ที่เหมาะสมภายหลัง</p>'+
    '<div class="row"><button class="primary" data-close>กลับไปผจญภัย</button></div>');
};
$('help').onclick=showHelp;

// F2 must never finish by awakening Aurelian or unlock the old Relay demo.
ending=()=>{finished=false;winTime=0;say('ATLAS','Aurelian ยังเป็นจุดหมายระยะไกล · MAP 1 จะจบหลังเหตุการณ์ Willow Road และ viewpoint ในเฟสถัดไป',5);};
const relayLaunch=document.getElementById('relayLaunch');if(relayLaunch)relayLaunch.hidden=true;

const f2BeginBase=begin;
begin=(resume=false)=>{
  const s=resume?readSave():null;
  f2WillowReached=!!s?.f2WillowReached;
  f2Visited=new Set(s?.f2Visited?.length?s.f2Visited:[0]);
  lioraJoined=false;gateTimer=0;lens=0;finished=false;winTime=0;
  const r=f2BeginBase(resume);
  lioraJoined=false;liora.hold=false;liora.command='waiting';liora.moving=0;gateTimer=0;lens=0;finished=false;winTime=0;
  if(relayLaunch)relayLaunch.hidden=true;
  refresh();save();
  if(resume){
    if(f2WillowReached)say('ATLAS','กลับสู่เส้นทางที่ Willow Road · ร่องรอยที่บันทึกไว้ยังอยู่',4.5);
    else if(active.has(5))say('ATLAS','Meadow Relay ฟื้นแล้ว · เดินต่อไปยัง Willow Road',4.5);
    else if(active.has(2))say('ATLAS','Basin Gardens ฟื้นแล้ว · รอยเส้นทางถัดไปผ่าน Broken Crossing',4.5);
  }
  return r;
};

$('begin').onclick=()=>{
  if(readSave())openModal('เริ่มการเดินทางใหม่','<p>เริ่มใหม่จะสร้างเส้นทาง F2 ใหม่และแทนที่เซฟ F2 ปัจจุบัน โดยไม่อ่านความสำเร็จ Aurelian จาก prototype เก่าเป็น MAP 1 complete</p><div class="row"><button class="primary" id="confirmnewf2">เริ่มใหม่</button><button class="secondary" data-close>กลับ</button></div>',()=>{$('confirmnewf2').onclick=()=>{closeModal();begin(false);};});
  else begin(false);
};
$('continue').onclick=()=>begin(true);
$('continue').hidden=!readSave();

document.title='WONDERBOUND — The Living Atlas · F2 Route/Event Candidate';
const edition=document.querySelector('.edition');if(edition)edition.textContent='F2 · ROUTE / EVENT CANDIDATE';
const sf=document.querySelector('.startfooter');if(sf)sf.innerHTML='F2 / ROUTE-EVENT CANDIDATE<br><br>A PLAYABLE WORLD, WAITING TO BE DRAWN.';

if(window.WB_MAP_FLOW){
  // Preserve the original live map1Sparks/map1Fractures getters.
  // Replacing the object with {...WB_MAP_FLOW} snapshots getter values and breaks telemetry.
  window.WB_MAP_FLOW.version=F2_ROUTE.version;
  Object.defineProperty(window.WB_MAP_FLOW,'map2Unlocked',{configurable:true,enumerable:true,get(){return false;}});
  window.WB_MAP_FLOW.openMap2=()=>{};
  window.WB_MAP_FLOW.restartMap1=()=>{try{localStorage.removeItem(F2_ROUTE.key);}catch(e){};begin(false);};
}
if(window.WB_STORY){
  window.WB_STORY={
    ...window.WB_STORY,
    version:'f2-later-liora',
    get lioraJoined(){return false;},
    get meetingAvailable(){return false;},
    openLioraEncounter:()=>{},
    joinLiora:()=>{}
  };
}
window.WB={
  ...window.WB,
  version:F2_ROUTE.version,
  begin,activate,use,companion,addBridge,save,readSave,
  get state(){return{
    player,active:[...active],found:[...found],bridges,checkpoint,
    f2WillowReached,f2Visited:[...f2Visited],lioraJoined:false,
    lens:0,gateTimer:0,rescues,finished:false,elapsed,atlas,paused,
    dashTime,dashCooldown,selected,renderOrder:V2.renderOrder
  };}
};
window.WB_F2_ROUTE={
  version:F2_ROUTE.version,
  saveKey:F2_ROUTE.key,
  get willowReached(){return f2WillowReached;},
  get visited(){return [...f2Visited];},
  get lockedAnchors(){return [...F2_ROUTE.lockedAnchors];}
};

refresh();
})();
</script>

<!-- MAP 1 F3 LIORA ENCOUNTER / REQUIRED RECRUITMENT PATCH -->
<script id="wb-map1-f3-liora-encounter-v1-script">
(()=>{
'use strict';

const F3_LIORA={
  version:'map1-f3-liora-encounter-v1',
  key:'wonderbound_living_atlas_map1_f3_v1',
  f2Key:(window.WB_F2_ROUTE&&window.WB_F2_ROUTE.saveKey)||'wonderbound_living_atlas_map1_f2_v1'
};
const F3_WILLOW={
  liora:{x:islands[8].x-54,y:islands[8].y+28},
  traveler:{x:islands[8].x+43,y:islands[8].y+39},
  marker:{x:islands[8].x+8,y:islands[8].y-17}
};
let f3Event='unseen';       // unseen -> met -> helped
let f3Decision='pending';   // pending -> join
let f3Hydrating=false;
let f3EncounterOpening=false;

function f3WillowReached(){return !!(window.WB_F2_ROUTE&&window.WB_F2_ROUTE.willowReached);}
function f3F2Visited(){return window.WB_F2_ROUTE&&Array.isArray(window.WB_F2_ROUTE.visited)?window.WB_F2_ROUTE.visited:[0];}
function f3Pos(p){return p&&Number.isFinite(p.x)&&Number.isFinite(p.y)?{x:p.x,y:p.y}:null;}
function f3ValidDecision(v){return ['pending','join'].includes(v)?v:'pending';}
function f3ValidEvent(v){return ['unseen','met','helped'].includes(v)?v:'unseen';}
function f3Normalize(raw){
  if(!raw||![4,5].includes(raw.version)||!Array.isArray(raw.active)||!Array.isArray(raw.found))return null;
  const a=[0];if(raw.active.includes(2))a.push(2);if(a.includes(2)&&raw.active.includes(5))a.push(5);
  const seen=new Set(),links=[];
  for(const l of Array.isArray(raw.bridges)?raw.bridges:[]){
    if(!l||!Number.isInteger(l.a)||!Number.isInteger(l.b)||!islands[l.a]||!islands[l.b]||l.a===l.b||dist(islands[l.a],islands[l.b])>MAX_LINK)continue;
    if(l.a===9||l.b===9)continue;
    const id=[l.a,l.b].sort((x,y)=>x-y).join(':');
    if(!seen.has(id)){seen.add(id);links.push({a:l.a,b:l.b});}
  }
  const isF3=raw.version===5;
  const decision=isF3?f3ValidDecision(raw.f3Decision):'pending';
  let event=isF3?f3ValidEvent(raw.f3Event):'unseen';
  if(decision!=='pending'&&event!=='helped')event='helped';
  const cp=[0,2,5,8].includes(raw.checkpoint)?raw.checkpoint:(a.includes(5)?5:a.includes(2)?2:0);
  return {
    version:5,active:a,found:[...new Set(raw.found.filter(n=>Number.isInteger(n)&&n>=0&&n<4))],
    bridges:links.slice(-3),checkpoint:cp,lens:0,elapsed:Math.max(0,Number(raw.elapsed)||0),
    rescues:Math.max(0,Math.floor(Number(raw.rescues)||0)),weaves:Math.max(0,Math.floor(Number(raw.weaves)||0)),
    player:f3Pos(raw.player),liora:isF3?f3Pos(raw.liora):null,lioraJoined:decision==='join',hold:false,gateTimer:0,
    cinematicSeen:false,finished:false,
    f2WillowReached:raw.f2WillowReached===true,
    f2Visited:Array.isArray(raw.f2Visited)?raw.f2Visited.filter(n=>Number.isInteger(n)&&n>=0&&n<islands.length):[0],
    f3Event:event,f3Decision:decision
  };
}
function f3ReadRaw(key){try{const v=localStorage.getItem(key);return v?JSON.parse(v):null;}catch(e){return null;}}
readSave=()=>{
  const own=f3Normalize(f3ReadRaw(F3_LIORA.key));
  if(own)return own;
  return f3Normalize(f3ReadRaw(F3_LIORA.f2Key));
};
save=()=>{
  if(!started||f3Hydrating)return;
  try{
    localStorage.setItem(F3_LIORA.key,JSON.stringify({
      version:5,active:[...active].filter(n=>[0,2,5].includes(n)),found:[...found],
      checkpoint:[0,2,5,8].includes(checkpoint)?checkpoint:0,lens:0,elapsed,rescues,weaves,
      bridges:bridges.filter(b=>b.a!==9&&b.b!==9).map(b=>({a:b.a,b:b.b})),
      player:stable(player)?{x:player.x,y:player.y}:null,
      liora:lioraJoined&&stable(liora)?{x:liora.x,y:liora.y}:null,
      lioraJoined,hold:false,gateTimer:0,cinematicSeen:false,finished:false,
      f2WillowReached:f3WillowReached(),f2Visited:f3F2Visited(),
      f3Event,f3Decision
    }));
    $('saveinfo').textContent='บันทึก MAP 1 · Liora ร่วมทางแล้ว';
    $('saveinfo').classList.remove('savewarn');
  }catch(e){
    $('saveinfo').textContent='บันทึกไม่ได้ในเบราว์เซอร์นี้ · ยังเล่นต่อได้';
    $('saveinfo').classList.add('savewarn');
  }
};

function f3ParkLiora(){
  liora.x=F3_WILLOW.liora.x;liora.y=F3_WILLOW.liora.y;liora.hold=false;liora.command='waiting';liora.moving=0;
  V2.command='follow';V2.nav=[];V2.navAge=0;V2.stranded=false;V2.navEpoch++;
}
function f3ActivateFollower(savedPos=null){
  lioraJoined=true;liora.hold=false;liora.command='follow';liora.moving=0;V2.command='follow';V2.nav=[];V2.navAge=0;V2.stranded=false;V2.navEpoch++;
  if(savedPos&&stable(savedPos)){liora.x=savedPos.x;liora.y=savedPos.y;}
  else if(stable(player)){liora.x=player.x-34;liora.y=player.y+24;if(!stable(liora)){liora.x=islands[8].x-36;liora.y=islands[8].y+35;}}
}
function f3PlaceEncounterActors(){if(!lioraJoined&&f3Event!=='unseen')f3ParkLiora();}

meetingAvailable=()=>f3Event==='helped'&&f3Decision==='pending';

function openWillowEncounter(){
  if(f3Event!=='unseen'||f3EncounterOpening)return;
  f3EncounterOpening=true;f3Event='met';f3PlaceEncounterActors();refresh();save();
  openModal('WILLOW ROAD — รอยทางที่พาคนหลง',
    '<p>ที่ Willow Road คุณพบ <b>Liora</b> กำลังช่วยนักเดินทางคนหนึ่งอยู่ข้างหลักทางที่ดับลง เครื่องหมายบนหลักชี้ไปยังทางเดิมซึ่งขาดหายไปแล้ว</p>'+ 
    '<p><b>LIORA</b> — “เขาเดินตามเครื่องหมายนี้มา แต่ทางที่บันทึกไว้ไม่มีอยู่ตรงหน้าเหมือนของเธอ ฉันยังไม่อยากบอกว่าแผนที่ไหนผิด เราต้องทำให้หลักทางตอบสนองก่อน”</p>'+ 
    '<p>Living Atlas อ่านร่องรอยของแสงจาก Meadow Relay ได้ หากคุณรักษาการเชื่อมต่อมาถึง Willow Road หลักทางอาจแสดงเส้นที่ใช้งานได้จริงให้นักเดินทางเห็น</p>'+ 
    '<div class="row"><button class="primary" id="f3HelpGo">ช่วยตรวจเส้นทาง</button></div>',
    ()=>{$('f3HelpGo').onclick=()=>{closeModal();f3EncounterOpening=false;say('ATLAS','พาแสงจาก Meadow Relay มาถึง Willow Road แล้วกด E ที่หลักทาง',6);refresh();};}
  );
}
openLioraEncounter=openWillowEncounter;

function f3HelpTraveler(){
  if(f3Event!=='met')return;
  if(!active.has(5)){say('ATLAS','Meadow Relay ยังไม่ฟื้น · หลักทางไม่มีสัญญาณต้นทางให้ตรวจ',4.5);return;}
  if(!powered().has(8)){say('LIORA','แสงยังมาไม่ถึง Willow Road ลองจัดสะพานให้สัญญาณต่อมาถึงหลักนี้ก่อน',5);return;}
  f3Event='helped';checkpoint=8;safeTime=2.5;
  spawn(F3_WILLOW.marker.x,F3_WILLOW.marker.y,70,'#ffe2a0',2.5);waves.push({x:F3_WILLOW.marker.x,y:F3_WILLOW.marker.y,r:0,life:2.6});
  tone(330,.5);tone(494,.75,.12);tone(659,.9,.2);
  refresh();save();
  say('LIORA','เห็นแล้ว—หลักทางไม่ได้ชี้กลับไปทางเก่า มันตอบเส้นที่เธอเชื่อมจริง ๆ นักเดินทางกลับไปยังทางปลอดภัยได้แล้ว',7);
}
function openLioraChoice(){
  if(!meetingAvailable())return;
  openModal('LIORA — หลังเส้นทางกลับมามีแสง',
    '<p>นักเดินทางออกจาก Willow Road ตามหลักที่สว่างขึ้น Liora มองเส้นสะพานที่คุณขีด แล้วจดบางอย่างลงในสมุดของเธอ</p>'+ 
    '<p><b>LIORA</b> — “Atlas ของเธอเห็นทางที่บันทึกของฉันไม่มี แต่เราเพิ่งพิสูจน์ได้อย่างหนึ่ง: เส้นนั้นช่วยคนได้จริง ฉันอยากตามเรื่องนี้ต่อ”</p>'+ 
    '<p>เธอมองไปยังเส้นทางข้างหน้า แล้วเสนอว่าจะช่วยเทียบเครื่องหมายที่เธอรู้จักกับสิ่งที่ Living Atlas มองเห็น หากคุณชวนเธอร่วมทาง</p>'+ 
    '<div class="row"><button class="primary" id="f3Join">ชวน Liora ร่วมเดินทาง</button><button class="secondary" data-close>ค่อยคุยอีกที</button></div>',
    ()=>{
      $('f3Join').onclick=()=>f3Choose('join');
    }
  );
}
function f3Choose(choice){
  if(!meetingAvailable()||choice!=='join')return;
  f3Decision='join';checkpoint=8;
  f3ActivateFollower();
  closeModal();refresh();save();
  say('LIORA','งั้นไปด้วยกัน ฉันจะเทียบเครื่องหมายที่รู้กับสิ่งที่ Atlas ของเธอเห็น—ถ้ามันไม่ตรงกัน เราตรวจจากโลกจริง',7);
}
joinLiora=()=>f3Choose('join');

const f3InteractionBase=interaction;
interaction=()=>{
  if(paused||atlas||!started)return null;
  const here=onIsland(player,4);
  if(here&&here.id===8&&dist(player,islands[8])<=83){
    if(f3Event==='unseen'&&f3WillowReached())return{label:'E · ดูเหตุการณ์ที่ Willow Road',action:openWillowEncounter};
    if(f3Event==='met')return{
      label:powered().has(8)?'E · ส่งสัญญาณให้หลักทาง':'E · หลักทางยังไม่มีแสง',
      action:f3HelpTraveler
    };
    if(f3Event==='helped'&&f3Decision==='pending')return{label:'E · คุยกับ Liora',action:openLioraChoice};
    if(f3Decision==='join')return{label:'E · คุยกับ Liora',action:()=>say('LIORA','ทางขึ้นจุดมองเห็นอยู่ข้างหน้า ฉันจะตามเส้นที่เธอจัดไว้',4.5)};
  }
  return f3InteractionBase();
};

const f3RefreshBase=refresh;
refresh=()=>{
  f3RefreshBase();
  $('seal9').classList.toggle('on',f3Decision!=='pending');
  if(lioraJoined){
    $('companion').hidden=false;$('companionstate').hidden=false;
    $('companion').innerHTML='<kbd>R</kbd>Liora';
    $('companionstate').textContent=V2.stranded?'Liora รอเส้นทางที่เชื่อมถึงคุณ':'Liora กำลังเดินตามเส้นทางของคุณ';
  }else{
    $('companion').hidden=true;$('companionstate').hidden=true;
  }
  if(f3Decision==='join'){
    $('chapter').textContent='F3 / JOURNEY TOGETHER';
    $('objective').textContent='เตรียมเดินต่อจาก Willow Road';
    $('objectivehint').textContent='Liora ร่วมทางแล้ว · ช่วง viewpoint จะเปิดในเฟสถัดไป';
  }else if(f3Event==='helped'){
    $('chapter').textContent='F3 / AFTER THE RESCUE';
    $('objective').textContent='คุยกับ Liora';
    $('objectivehint').textContent='ช่วยนักเดินทางสำเร็จแล้ว · เข้าใกล้ Liora แล้วกด E';
  }else if(f3Event==='met'){
    $('chapter').textContent='F3 / WILLOW ROAD';
    $('objective').textContent='ช่วยนักเดินทางที่หลงเส้นทาง';
    $('objectivehint').textContent=powered().has(8)?'แสงมาถึงแล้ว · กด E ที่หลักทาง Willow Road':'จัดสะพานให้แสงจาก Meadow Relay มาถึง Willow Road';
  }else if(f3WillowReached()){
    $('chapter').textContent='F3 / SOMEONE AHEAD';
    $('objective').textContent='ดูว่าเกิดอะไรขึ้นที่ Willow Road';
    $('objectivehint').textContent='เข้าไปกลาง Willow Road เพื่อพบ Liora และนักเดินทาง';
  }
};

const f3MoveF2Base=moveLiora;
moveLiora=dt=>{
  if(lioraJoined){storyBaseMoveLiora(dt);return;}
  if(f3Event!=='unseen')f3ParkLiora();
  else f3MoveF2Base(dt);
};

const f3CanRemoveF2Base=canRemove;
canRemove=(b,replacement=null)=>{
  if(lioraJoined)return storyBaseCanRemove(b,replacement);
  return f3CanRemoveF2Base(b,replacement);
};

// F5.4 QA FIX — preserve the MAP 1 Fail-Forward/Spark wrapper introduced before F3.
// F3 previously replaced `rescue` and bypassed that wrapper, so MAP 1 Sparks,
// Recovery telemetry and Fracture telemetry never changed after F3.
const f3FlowRescueBase=rescue;
rescue=reason=>{
  const r=f3FlowRescueBase(reason);
  if(lioraJoined){
    if(checkpoint===8&&!stable(liora)){liora.x=islands[8].x-34;liora.y=islands[8].y+30;}
  }else if(f3Event!=='unseen'){
    f3ParkLiora();
  }
  refresh();save();
  return r;
};

companion=()=>{
  if(!started||paused||atlas)return;
  if(!lioraJoined){say('ATLAS','ชวน Liora ร่วมเดินทางที่ Willow Road ก่อน จึงจะเดินหน้าต่อได้',3.8);return;}
  liora.hold=false;liora.command='follow';V2.command='follow';V2.navAge=0;V2.navEpoch++;
  if(V2.stranded)say('LIORA','ฉันยังตามไปไม่ได้ ลองต่อสะพานให้เส้นทางถึงกันก่อนนะ',5);
  else say('LIORA','ฉันตามอยู่ ถ้าเราเห็นเครื่องหมายไม่ตรงกัน ให้เชื่อสิ่งที่ตรวจจากพื้นที่ก่อน',5);
  refresh();save();
};
$('companion').onclick=companion;

const f3RenderF2Base=renderCharacter;
renderCharacter=(c,isLiora=false)=>{
  if(!isLiora)return f3RenderF2Base(c,false);
  if(f3Event==='unseen')return;
  // Bypass F2's intentional Liora suppression while retaining the pre-F2 character treatment.
  storyBaseRenderCharacter(c,true);
  if(atlas||!started)return;
  const p=worldToScreen(c.x,c.y,0),s=camera.z;
  ctx.save();ctx.globalAlpha=.9;ctx.shadowBlur=8*s;ctx.shadowColor='#9ff1db';
  ellipse(p.x,p.y+7*s,17*s,10*s,null,'#9fe9d5',1.8*s);circle(p.x+9*s,p.y-36*s,2.4*s,'#aef1dc');ctx.restore();
};

function f3RenderEvent(){
  if(!started||atlas||f3Event==='unseen'||f3Decision!=='pending')return;
  const tp=worldToScreen(F3_WILLOW.traveler.x,F3_WILLOW.traveler.y,0),mp=worldToScreen(F3_WILLOW.marker.x,F3_WILLOW.marker.y,0),s=camera.z;
  ctx.save();
  if(f3Event==='met'){
    ctx.globalAlpha=.92;ellipse(tp.x,tp.y+5*s,13*s,8*s,null,'#d2c6a5',1.4*s);circle(tp.x,tp.y-25*s,6*s,'#c8b893');
    label('ผู้เดินทาง',tp.x,tp.y-39*s,10,'#e7dcc0');
  }
  const lit=powered().has(8);ctx.shadowBlur=lit?12*s:0;ctx.shadowColor='#ffe3a1';
  path([[mp.x,mp.y-18*s],[mp.x+8*s,mp.y],[mp.x,mp.y+18*s],[mp.x-8*s,mp.y]],lit?'#dfc77d':'#47605b',lit?'#ffe9ac':'#96afa7',1.5*s);
  if(f3Event==='met')label(lit?'หลักทางมีสัญญาณ':'หลักทางดับอยู่',mp.x,mp.y+34*s,10,lit?'#ffe7a1':'#adc2ba');
  ctx.restore();
}
const f3RenderBase=render;
render=()=>{f3RenderBase();f3RenderEvent();};

const f3UpdateBase=update;
update=dt=>{
  const r=f3UpdateBase(dt);
  if(started&&!paused&&!atlas){
    if(!lioraJoined&&f3Event!=='unseen')f3ParkLiora();
    const here=onIsland(player);
    if(f3Event==='unseen'&&f3WillowReached()&&here&&here.id===8&&!f3EncounterOpening)openWillowEncounter();
  }
  return r;
};

showHelp=()=>{
  openModal('เส้นทางเกิดจากมือคุณ',
    '<p>MAP 1 ยังใช้กฎเดิม: ขีดสะพาน เดินบนสิ่งที่ขีด และส่งแสงผ่านเส้นเดียวกัน</p>'+ 
    '<div class="helpgrid">'+
    '<b>WASD / จอย</b><span>เดินบนเกาะและสะพาน</span>'+ 
    '<b>Q / Atlas</b><span>ลากหมุด หรือแตะต้นทางและปลายทางเพื่อสร้างสะพาน</span>'+ 
    '<b>3 เส้น</b><span>เส้นที่ 4 แทนเส้นเก่าที่สุดเมื่อ Wayfinder และ Liora ปลอดภัย</span>'+ 
    '<b>Space</b><span>พุ่งตามทิศที่เดิน</span>'+ 
    '<b>E</b><span>ฟื้นหลักสัญญาณ ช่วยนักเดินทาง และคุยกับตัวละครในโลก</span>'+ 
    '<b>Willow Road</b><span>ช่วยสถานการณ์ให้สำเร็จ แล้วชวน Liora ร่วมเดินทางก่อนออกจากพื้นที่</span>'+ 
    (lioraJoined?'<b>R / Liora</b><span>ย้ำคำสั่ง Follow และดูสถานะเส้นทางของเธอ</span>':'')+
    '</div><p class="fine">การเดินทางต่อจาก Willow Road ต้องมี Liora ร่วมทาง; MAP 1 ยังไม่จบจนกว่าจะผ่าน viewpoint ในเฟสถัดไป</p>'+ 
    '<div class="row"><button class="primary" data-close>กลับไปผจญภัย</button></div>');
};
$('help').onclick=showHelp;

// F3 still cannot reach or awaken Aurelian. F4 owns viewpoint/reveal/completion.
ending=()=>{finished=false;winTime=0;say('ATLAS',lioraJoined?'Liora ร่วมทางแล้ว · จุดมองเห็น Aurelian จะอยู่ถัดจากช่วงนี้':'ชวน Liora ร่วมเดินทางที่ Willow Road ก่อน จึงจะเปิดเส้นทางไปจุดมองเห็น',5);};

const f3BeginBase=begin;
begin=(resume=false)=>{
  const s=resume?readSave():null;
  f3Hydrating=true;
  try{f3BeginBase(resume);}finally{f3Hydrating=false;}
  f3Event=resume&&s?f3ValidEvent(s.f3Event):'unseen';
  f3Decision=resume&&s?f3ValidDecision(s.f3Decision):'pending';
  finished=false;winTime=0;gateTimer=0;lens=0;
  if(resume&&s&&[0,2,5,8].includes(s.checkpoint))checkpoint=s.checkpoint;
  if(f3Decision==='join')f3ActivateFollower(s?.liora||null);
  else{lioraJoined=false;if(f3Event!=='unseen')f3ParkLiora();}
  if(f3Event==='helped'&&checkpoint!==8)checkpoint=8;
  refresh();save();
  if(resume){
    if(f3Decision==='join')say('ATLAS','กลับสู่ Willow Road · Liora ยังร่วมทางกับคุณ',4.5);
    else if(f3Event==='helped')say('ATLAS','นักเดินทางปลอดภัยแล้ว · กลับไปคุยกับ Liora ที่ Willow Road',4.5);
    else if(f3Event==='met')say('ATLAS','เหตุการณ์ที่ Willow Road ยังรอให้คุณพาแสงมาถึงหลักทาง',4.5);
  }
  return true;
};

$('begin').onclick=()=>{
  if(readSave())openModal('เริ่มการเดินทางใหม่','<p>เริ่มใหม่จะสร้างเซฟ F3 ใหม่ โดยเก็บไฟล์เซฟ F2 เดิมไว้เป็นจุดย้อนกลับ สถานะการร่วมทางกับ Liora ปัจจุบันจะถูกแทนที่</p><div class="row"><button class="primary" id="confirmnewf3">เริ่มใหม่</button><button class="secondary" data-close>กลับ</button></div>',()=>{$('confirmnewf3').onclick=()=>{try{localStorage.removeItem(F3_LIORA.key);}catch(e){}closeModal();begin(false);};});
  else begin(false);
};
$('continue').onclick=()=>begin(true);
$('continue').hidden=!readSave();

document.title='WONDERBOUND — The Living Atlas · F3 Liora Encounter Candidate';
const editionF3=document.querySelector('.edition');if(editionF3)editionF3.textContent='F3 · LIORA ENCOUNTER CANDIDATE';
const sfF3=document.querySelector('.startfooter');if(sfF3)sfF3.innerHTML='F3 / LIORA ENCOUNTER CANDIDATE<br><br>A PLAYABLE WORLD, WAITING TO BE DRAWN.';

if(window.WB_STORY){
  window.WB_STORY={
    ...window.WB_STORY,
    version:F3_LIORA.version,
    get lioraJoined(){return lioraJoined;},
    get meetingAvailable(){return meetingAvailable();},
    openLioraEncounter:openWillowEncounter,
    joinLiora:()=>f3Choose('join'),
    get willowEvent(){return f3Event;},
    get lioraDecision(){return f3Decision;}
  };
}
window.WB={
  ...window.WB,
  version:F3_LIORA.version,
  begin,use,companion,save,readSave,render,
  get state(){return{
    player,liora,lioraJoined,active:[...active],found:[...found],bridges,checkpoint,
    willowReached:f3WillowReached(),willowEvent:f3Event,lioraDecision:f3Decision,
    lens:0,gateTimer:0,rescues,finished:false,elapsed,atlas,paused,dashTime,dashCooldown,
    selected,nav:V2.nav,stranded:V2.stranded,renderOrder:V2.renderOrder
  };}
};
window.WB_F3_LIORA={
  version:F3_LIORA.version,
  saveKey:F3_LIORA.key,
  sourceSaveKey:F3_LIORA.f2Key,
  get event(){return f3Event;},
  get decision(){return f3Decision;},
  get joined(){return lioraJoined;},
  get travelerHelped(){return f3Event==='helped';},
  debug:{openEncounter:openWillowEncounter,helpTraveler:f3HelpTraveler,choose:f3Choose}
};

refresh();
})();
</script>


<!-- MAP 1 F4 VIEWPOINT / AURELIAN REVEAL / COMPLETION CANDIDATE V1 -->
<script id="wb-map1-f4-viewpoint-reveal-v1-script">
(()=>{
'use strict';

const F4_FINALE={
  version:'map1-f4-liora-join-required-v2',
  key:'wonderbound_living_atlas_map1_f4_join_required_v2',
  legacyKey:'wonderbound_living_atlas_map1_f4_v1',
  f3Key:(window.WB_F3_LIORA&&window.WB_F3_LIORA.saveKey)||'wonderbound_living_atlas_map1_f3_v1'
};
let f4ViewpointReached=false;
let f4RevealSeen=false;
let f4Complete=false;
let f4Hydrating=false;
let f4OpeningReveal=false;

// The former Aurelian destination geometry becomes a real viewpoint for MAP 1.
// Aurelian itself is now only revealed as a distant horizon landmark.
// Keep close-up Aurelian artwork out of the repurposed MAP 1 route before the horizon reveal.
islands[5].art=4;islands[7].art=3;islands[8].art=0;
Object.assign(islands[9],{
  name:'Horizon Viewpoint',
  th:'ระเบียงมองไกลเหนือ Willow Road',
  kind:'viewpoint',
  art:4,
  f2Locked:true
});

function f4Decision(){return window.WB_F3_LIORA?window.WB_F3_LIORA.decision:'pending';}
function f4Event(){return window.WB_F3_LIORA?window.WB_F3_LIORA.event:'unseen';}
function f4CanTravel(){return f4Event()==='helped'&&f4Decision()==='join'&&lioraJoined;}
function f4Pos(p){return p&&Number.isFinite(p.x)&&Number.isFinite(p.y)?{x:p.x,y:p.y}:null;}
function f4ReadRaw(key){try{const v=localStorage.getItem(key);return v?JSON.parse(v):null;}catch(e){return null;}}
function f4Normalize(raw){
  if(!raw||![4,5,6,7].includes(raw.version)||!Array.isArray(raw.active)||!Array.isArray(raw.found))return null;
  const isF4=[6,7].includes(raw.version);
  // Join-only rule: legacy solo saves return to the post-rescue recruitment step.
  const decision=raw.f3Decision==='join'?'join':'pending';
  let event=['unseen','met','helped'].includes(raw.f3Event)?raw.f3Event:'unseen';
  if(decision!=='pending')event='helped';
  let viewpoint=isF4&&raw.f4ViewpointReached===true&&decision!=='pending';
  let reveal=isF4&&raw.f4RevealSeen===true&&viewpoint;
  let complete=isF4&&raw.f4Complete===true&&reveal;
  const a=[0];if(raw.active.includes(2))a.push(2);if(a.includes(2)&&raw.active.includes(5))a.push(5);
  const seen=new Set(),links=[];
  for(const l of Array.isArray(raw.bridges)?raw.bridges:[]){
    if(!l||!Number.isInteger(l.a)||!Number.isInteger(l.b)||!islands[l.a]||!islands[l.b]||l.a===l.b||dist(islands[l.a],islands[l.b])>MAX_LINK)continue;
    if((l.a===9||l.b===9)&&decision==='pending')continue;
    if((l.a===9||l.b===9)&&((l.a===9?l.b:l.a)!==8))continue;
    const id=[l.a,l.b].sort((x,y)=>x-y).join(':');
    if(!seen.has(id)){seen.add(id);links.push({a:l.a,b:l.b});}
  }
  let cp=[0,2,5,8].includes(raw.checkpoint)?raw.checkpoint:(a.includes(5)?5:a.includes(2)?2:0);
  return {
    version:7,active:a,found:[...new Set(raw.found.filter(n=>Number.isInteger(n)&&n>=0&&n<4))],
    bridges:links.slice(-3),checkpoint:cp,lens:0,elapsed:Math.max(0,Number(raw.elapsed)||0),
    rescues:Math.max(0,Math.floor(Number(raw.rescues)||0)),weaves:Math.max(0,Math.floor(Number(raw.weaves)||0)),
    player:f4Pos(raw.player),liora:f4Pos(raw.liora),lioraJoined:decision==='join',hold:false,gateTimer:0,
    cinematicSeen:false,finished:false,
    f2WillowReached:raw.f2WillowReached===true,
    f2Visited:Array.isArray(raw.f2Visited)?raw.f2Visited.filter(n=>Number.isInteger(n)&&n>=0&&n<islands.length):[0],
    f3Event:event,f3Decision:decision,
    f4ViewpointReached:viewpoint,f4RevealSeen:reveal,f4Complete:complete
  };
}

readSave=()=>{
  const own=f4Normalize(f4ReadRaw(F4_FINALE.key));
  if(own)return own;
  const legacy=f4Normalize(f4ReadRaw(F4_FINALE.legacyKey));
  if(legacy)return legacy;
  return f4Normalize(f4ReadRaw(F4_FINALE.f3Key));
};

save=()=>{
  if(!started||f4Hydrating)return;
  try{
    const visited=window.WB_F2_ROUTE&&Array.isArray(window.WB_F2_ROUTE.visited)?window.WB_F2_ROUTE.visited:[0];
    localStorage.setItem(F4_FINALE.key,JSON.stringify({
      version:7,active:[...active].filter(n=>[0,2,5].includes(n)),found:[...found],
      checkpoint:[0,2,5,8].includes(checkpoint)?checkpoint:0,lens:0,elapsed,rescues,weaves,
      bridges:bridges.filter(b=>!(b.a===9||b.b===9)||((b.a===9?b.b:b.a)===8&&f4CanTravel())).map(b=>({a:b.a,b:b.b})),
      player:stable(player)?{x:player.x,y:player.y}:null,
      liora:lioraJoined&&stable(liora)?{x:liora.x,y:liora.y}:null,
      lioraJoined,hold:false,gateTimer:0,cinematicSeen:false,finished:false,
      f2WillowReached:!!(window.WB_F2_ROUTE&&window.WB_F2_ROUTE.willowReached),
      f2Visited:[...new Set([...(visited||[]),...(f4ViewpointReached?[9]:[])])],
      f3Event:f4Event(),f3Decision:f4Decision(),
      f4ViewpointReached,f4RevealSeen,f4Complete
    }));
    $('saveinfo').textContent=f4Complete?'บันทึก MAP 1 COMPLETE แล้ว':'บันทึก MAP 1 · Viewpoint แล้ว';
    $('saveinfo').classList.remove('savewarn');
  }catch(e){
    $('saveinfo').textContent='บันทึกไม่ได้ในเบราว์เซอร์นี้ · ยังเล่นต่อได้';
    $('saveinfo').classList.add('savewarn');
  }
};

function f4UnlockViewpoint(){islands[9].f2Locked=!f4CanTravel();}
f4UnlockViewpoint();

// Rebuild anchor hit testing so node 9 becomes selectable only after Liora joins at Willow Road.
anchorAt=(x,y)=>{
  let result=null,best=Infinity;
  for(const i of islands){
    if(i.id===9&&!f4CanTravel())continue;
    const p=worldToScreen(i.x,i.y+52),d=Math.hypot(x-p.x,y-p.y);
    if(d<best){best=d;result=i;}
  }
  return best<=Math.max(24,camera.z*24)?result:null;
};

// Preserve the original bridge transaction behavior while allowing only Willow Road -> Viewpoint for node 9.
addBridge=(a,b)=>{
  if(!started||paused||!Number.isInteger(a)||!Number.isInteger(b)||!islands[a]||!islands[b]||a===b)return false;
  if(a===9||b===9){
    if(!f4CanTravel()){say('ATLAS','เส้นทางไปจุดมองเห็นจะเปิดหลังช่วยนักเดินทางและชวน Liora ร่วมเดินทาง',4.5);return false;}
    const other=a===9?b:a;
    if(other!==8){say('ATLAS','จุดมองเห็นนี้ขึ้นจาก Willow Road โดยตรง · เริ่มเส้นจากหมุด Willow Road',4.5);return false;}
  }
  if(dist(islands[a],islands[b])>MAX_LINK){say('ATLAS','ไกลเกินเส้นเดียว ใช้เกาะระหว่างทางเป็นหลักต่อ',4);return false;}
  if(bridges.some(l=>(l.a===a&&l.b===b)||(l.a===b&&l.b===a))){say('ATLAS','มีสะพานเชื่อมหมุดคู่นี้แล้ว',3);return false;}
  const link={a,b,born:clock-.7};
  if(bridges.length===3){if(!canRemove(bridges[0],link))return false;bridges.shift();}
  bridges.push(link);V2.navEpoch++;weaves++;
  const A=islands[a],B=islands[b];for(let j=0;j<20;j++)spawn(lerp(A.x,B.x,j/19),lerp(A.y,B.y,j/19),1,'#ffe4a2',1);
  tone(420,.18);tone(630,.4,.1);refresh();save();
  if(a===9||b===9)say('ATLAS','เส้นขึ้นสู่ Horizon Viewpoint พร้อมแล้ว · ปิด Atlas แล้วเดินไปบนสิ่งที่คุณขีด',5.5);
  return true;
};

function f4RouteSummary(){return 'Liora ร่วมทาง';}
function f4LightMarks(){
  try{return window.WB_LIGHT_MARKS&&window.WB_LIGHT_MARKS.status?window.WB_LIGHT_MARKS.status():{found:0,total:islands.length,complete:false};}
  catch(e){return{found:0,total:islands.length,complete:false};}
}
function f4Fractures(){try{return window.WB_MAP_FLOW&&Number.isFinite(window.WB_MAP_FLOW.map1Fractures)?window.WB_MAP_FLOW.map1Fractures:0;}catch(e){return 0;}}

function f4ShowSummary(){
  if(!f4Complete)return;
  if(window.WB_MAP1_SCORE&&typeof window.WB_MAP1_SCORE.showSummary==='function'){window.WB_MAP1_SCORE.showSummary();return;}
  const lm=f4LightMarks(),fractures=f4Fractures();
  const lightNote=lm.complete?'บันทึกรอยแสงครบทุกจุดที่มีใน MAP 1':'ยังมีรอยแสงให้ย้อนสำรวจอีก '+Math.max(0,lm.total-lm.found)+' จุด';
  const companionLine='<p><b>LIORA</b> — “เห็นแล้ว… Aurelian อยู่ไกลกว่าที่เส้นบนแผนที่ทำให้รู้สึก แต่ตอนนี้เรามีหลักฐานจริงจากเส้นทางนี้แล้ว”</p>';
  openModal('MAP 1 COMPLETE — Aurelian บนขอบฟ้า',
    '<img class="endart" src="'+ART[8]+'" alt="Aurelian Spire อยู่ไกลบนขอบฟ้าจากจุดมองเห็น">'+
    '<div class="mapProgressTag">AZURE GATE → SOUTHWEST BASIN → WILLOW ROAD → HORIZON VIEWPOINT</div>'+ 
    '<div class="eyebrow">AURELIAN — FIRST SIGHT</div>'+ 
    '<p>จากระเบียงสูงเหนือ Willow Road คุณเห็น <b>Aurelian Spire</b> เป็นครั้งแรก—เล็กอยู่ไกลบนขอบฟ้า ไม่ใช่สถานที่ที่คุณเดินถึงใน MAP นี้ แต่เป็นหลักยืนยันว่าการเดินทางยังอีกยาวไกล</p>'+ 
    '<p>Living Atlas เก็บเส้นที่คุณขีดไว้ข้างแผนที่ทั่วไป และความคลาดเคลื่อนระหว่างสองฉบับยังไม่มีคำตอบว่าเหตุใดจึงเกิดขึ้น</p>'+companionLine+
    '<div class="stats map1SummaryStats">'+
      '<div><b>'+f4RouteSummary()+'</b><span class="statLabel">Companion</span><small class="statNote">Liora เข้าร่วมการเดินทางหลักแล้ว</small></div>'+ 
      '<div><b>'+found.size+' / 4</b><span class="statLabel">Chronicle</span><small class="statNote">ความทรงจำที่คุณพบระหว่าง MAP 1</small></div>'+ 
      '<div class="lightMarkStat"><b>'+lm.found+' / '+lm.total+'</b><span class="statLabel">รอยแสง</span><small class="statNote '+(lm.complete?'complete':'')+'">'+lightNote+'</small></div>'+ 
      '<div><b>'+weaves+'</b><span class="statLabel">สะพานที่ขีด</span><small class="statNote">ทุกเส้นเป็นทั้งทางเดินและการเชื่อมสัญญาณ</small></div>'+ 
      '<div><b>'+fractures+'</b><span class="statLabel">Fracture Echo</span><small class="statNote">Fail Forward ไม่ลบ Story หรือ Chronicle ที่ได้แล้ว</small></div>'+ 
      '<div><b>'+Math.floor(elapsed/60)+':'+String(Math.floor(elapsed%60)).padStart(2,'0')+'</b><span class="statLabel">เวลา MAP 1</span><small class="statNote">เวลาการเดินทางที่ถูกบันทึกใน candidate นี้</small></div>'+ 
    '</div>'+ 
    '<p><b>Atlas ยังไม่ให้คำตอบ มันให้เส้นทางต่อไป</b></p>'+ 
    '<div class="row"><button class="primary" id="f4Explore">กลับไปสำรวจ MAP 1</button><button class="secondary" id="f4Journal">เปิด Chronicle</button></div>'+ 
    '<p class="fine">MAP 2 campaign ยังไม่ถูกเปิดจาก prototype Relay เดิมใน candidate นี้</p>',
    ()=>{
      $('f4Explore').onclick=()=>closeModal();
      $('f4Journal').onclick=journal;
    }
  );
}

function f4RevealAurelian(){
  if(f4OpeningReveal||!f4CanTravel()||!f4ViewpointReached)return;
  if(f4Complete){f4ShowSummary();return;}
  f4OpeningReveal=true;f4RevealSeen=true;f4Complete=true;finished=false;winTime=0;
  tone(261,.6);tone(392,.9,.16);tone(523,1.1,.3);tone(659,1.3,.45);
  save();refresh();
  f4OpeningReveal=false;f4ShowSummary();
}

const f4InteractionBase=interaction;
interaction=()=>{
  if(paused||atlas||!started)return null;
  const here=onIsland(player,4);
  if(here&&here.id===9&&dist(player,islands[9])<=100){
    if(!f4CanTravel())return{label:'E · เส้นทางยังไม่เปิด',action:()=>say('ATLAS','กลับไปชวน Liora ร่วมเดินทางที่ Willow Road ก่อน',4)};
    if(!f4ViewpointReached)return{label:'E · บันทึกจุดมองเห็น',action:()=>{f4ViewpointReached=true;save();refresh();say('ATLAS','Horizon Viewpoint ถูกบันทึกแล้ว · มองออกไปยังขอบฟ้า',4.5);}};
    return{label:f4Complete?'E · ดูบันทึก MAP 1':'E · มองไปยังขอบฟ้า',action:f4RevealAurelian};
  }
  return f4InteractionBase();
};

const f4RefreshBase=refresh;
refresh=()=>{
  f4UnlockViewpoint();
  f4RefreshBase();
  $('seal9').classList.toggle('on',f4Complete);
  if(f4Complete){
    $('chapter').textContent='MAP 1 / COMPLETE';
    $('objective').textContent='Aurelian ปรากฏบนขอบฟ้า';
    $('objectivehint').textContent='การเดินทางช่วงแรกถูกบันทึกแล้ว · คุณยังกลับไปสำรวจ Chronicle และรอยแสงที่พลาดได้';
  }else if(f4ViewpointReached){
    $('chapter').textContent='F4 / THE DISTANT SPIRE';
    $('objective').textContent='มองออกไปยังขอบฟ้า';
    $('objectivehint').textContent='เข้าใกล้จุดชมวิวแล้วกด E เพื่อดูสิ่งที่อยู่ไกลออกไป';
  }else if(f4CanTravel()){
    $('chapter').textContent='F4 / BEYOND WILLOW ROAD';
    $('objective').textContent='เดินต่อไปยัง Horizon Viewpoint';
    $('objectivehint').textContent='เปิด Atlas แล้วเชื่อม Willow Road → Viewpoint จากนั้นเดินไปบนเส้นที่คุณขีด';
  }
};

const f4UpdateBase=update;
update=dt=>{
  const r=f4UpdateBase(dt);
  if(started&&!paused&&!atlas&&f4CanTravel()){
    const here=onIsland(player);
    if(here&&here.id===9&&!f4ViewpointReached){
      f4ViewpointReached=true;safeTime=2.5;save();refresh();
      say('ATLAS','คุณขึ้นมาถึง Horizon Viewpoint แล้ว · กด E เพื่อมองออกไปยังขอบฟ้า',5.5);
    }
  }
  return r;
};


// Keep Willow Road (checkpoint 8) as the safe landmark for the finale approach.
// Reaching the viewpoint is persistent Story progress, but a fall still uses the existing F3/Fail-Forward recovery.


showHelp=()=>{
  openModal('เส้นทางเกิดจากมือคุณ',
    '<p>หลัง Willow Road เป้าหมายสุดท้ายของ MAP 1 คือ <b>Horizon Viewpoint</b> ไม่ใช่การเดินไปถึง Aurelian</p>'+ 
    '<div class="helpgrid">'+
    '<b>Q / Atlas</b><span>เชื่อม Willow Road → Viewpoint หลังชวน Liora ร่วมเดินทางแล้ว</span>'+ 
    '<b>เดินจริง</b><span>ปิด Atlas แล้วเดินไปบนสะพานที่ขีดเอง Liora ต้องเดินตามผ่านเส้นทางเดียวกันจริง</span>'+ 
    '<b>E</b><span>ที่ Viewpoint ใช้เพื่อมองออกไปยังขอบฟ้าและจบ MAP 1</span>'+ 
    '<b>R / Liora</b><span>Liora ใช้ระบบ Follow เดิมและต้องมีทางเดินถึงคุณจริง</span>'+ 
    '</div><p class="fine">Aurelian เป็น Grand Landmark ระยะไกลใน MAP 1 และจะไม่ถูกปลุกหรือเดินถึงใน candidate นี้</p>'+ 
