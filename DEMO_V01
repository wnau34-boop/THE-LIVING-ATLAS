<!-- MAP 1 F5.3 CHRONICLE DISCOVERY + QA FIX V9 -->
<style id="wb-f53-chronicle-discovery-v9-style">
/* Chronicle must be legible as a game system before it can carry leaderboard weight. */
#memorycount{letter-spacing:.04em}
body.atlas #memorycount{color:#f2dfa5}
</style>
<script id="wb-f53-chronicle-discovery-v9-script">
(()=>{
'use strict';
const C9={
  version:'map1-f5-3-chronicle-discovery-v9',
  storyMemory:0,
  storyIsland:4,
  optionalIslands:[6,10,11],
  optionalMemories:[1,2,3]
};
let c9IntroShown=false;
let c9AutoLock=false;

function c9ChronicleCount(){return Math.max(0,Math.min(4,found.size));}
function c9RefreshHud(){
  const el=$('memorycount');
  if(el)el.textContent=`CHRONICLE · บันทึก ${c9ChronicleCount()} / 4`;
}
function c9StoryReady(){
  if(c9AutoLock||!started||paused||atlas||found.has(C9.storyMemory)||!active.has(2))return false;
  try{return onIsland(player,8)?.id===C9.storyIsland;}catch(e){return false;}
}
function c9DiscoverStoryChronicle(){
  if(!c9StoryReady())return false;
  c9AutoLock=true;
  found.add(C9.storyMemory);
  const i=islands[C9.storyIsland];
  spawn(i.x-20,i.y-8,65,'#a4edde',2.2);
  waves.push({x:i.x-20,y:i.y-8,r:0,life:2.4});
  tone(520,.45);tone(780,.65,.14);
  c9IntroShown=true;
  say('CHRONICLE · บันทึกแรก',memories[0].title+' · Living Atlas บันทึกเรื่องราวจากเส้นทางหลักแล้ว อีก 3 Chronicle ซ่อนอยู่บนเกาะสำรวจ — มองหา ◇ ใน Atlas แล้วเข้าใกล้เพื่อบันทึก',9);
  c9RefreshHud();
  save();
  c9AutoLock=false;
  return true;
}

const c9RefreshBase=refresh;
refresh=()=>{const r=c9RefreshBase();c9RefreshHud();return r;};

const c9UpdateBase=update;
update=dt=>{
  const r=c9UpdateBase(dt);
  if(c9StoryReady())c9DiscoverStoryChronicle();
  return r;
};

const c9InteractionBase=interaction;
interaction=()=>{
  const a=c9InteractionBase();
  let i=null;try{i=onIsland(player,4);}catch(e){}
  if(i&&i.kind==='memory'&&!found.has(i.memory)&&a){
    return {label:'E · บันทึก Chronicle',action:a.action};
  }
  return a;
};

function c9DrawDiamond(x,y,s,foundAlready=false,alpha=1){
  ctx.save();ctx.globalAlpha=alpha;ctx.shadowBlur=foundAlready?8*s:16*s;ctx.shadowColor=foundAlready?'#f0d999':'#9cf0dc';
  path([[x,y-12*s],[x+10*s,y],[x,y+12*s],[x-10*s,y]],foundAlready?'#d9c687':'#8ed9c8','#fff0b5',1.7*s);
  circle(x,y,3.1*s,foundAlready?'#284943':'#fff0b5');ctx.restore();
}
const c9RenderIslandBase=renderIsland;
renderIsland=(i,power,layer='all')=>{
  c9RenderIslandBase(i,power,layer);
  if(layer!=='props')return;
  const p=worldToScreen(i.x,i.y),s=camera.z;
  if(atlas){
    // Story Chronicle is taught on the route; optional Chronicle locations become readable after that lesson.
    if(i.id===C9.storyIsland&&!found.has(0)&&active.has(2)){
      c9DrawDiamond(p.x-18*s,p.y-54*s,Math.max(.85,s),false,.95);
      label('Story Chronicle',p.x,p.y-75*s,11,'#dff5df');
    }
    if(found.has(0)&&C9.optionalIslands.includes(i.id)){
      const mem=i.memory,got=found.has(mem);
      c9DrawDiamond(p.x,p.y-50*s,Math.max(.82,s),got,got?.62:1);
      label(got?'Chronicle ✓':'Chronicle ?',p.x,p.y-70*s,11,got?'#d7c98e':'#c9f1df');
    }
  }else if(i.kind==='memory'&&!found.has(i.memory)){
    // Make the optional discovery language visible before the player is standing directly on top of it.
    const near=dist(player,i)<430;
    c9DrawDiamond(p.x,p.y-52*s,Math.max(.9,s),false,near?1:.72);
    if(near)label('◇ CHRONICLE',p.x,p.y-76*s,11,'#d4f4e5');
  }
};

journal=()=>{
  const entries=[
    {title:memories[0].title,locked:'Chronicle หลัก · พบระหว่างเส้นทาง Broken Crossing'},
    {title:memories[1].title,locked:'Chronicle ? · เกาะสำรวจเหนือ Broken Crossing'},
    {title:memories[2].title,locked:'Chronicle ? · เกาะสำรวจใต้ Meadow Relay'},
    {title:memories[3].title,locked:'Chronicle ? · เกาะสำรวจฝั่งตะวันตกตอนบน'}
  ];
  openModal('Chronicle · บันทึกของ Living Atlas',
    '<p>Chronicle คือเรื่องราวหรือความทรงจำของสถานที่ที่ Living Atlas บันทึกไว้ ไม่ใช่คำเฉลยของโลกทั้งหมด</p>'+entries.map((e,i)=>
      '<div class="journalitem"><b>'+(found.has(i)?e.title:'◇ '+e.locked)+'</b><p>'+(found.has(i)?memories[i].text:(i===0?'เดินตามเส้นทางหลักต่อไป แล้ว Atlas จะสอนระบบนี้ให้เอง':'หลังพบ Chronicle แรก เปิด Living Atlas แล้วมองหาสัญลักษณ์ Chronicle ? บนเกาะสำรวจ'))+'</p></div>'
    ).join('')+'<div class="row"><button class="primary" data-close>ปิด Chronicle</button></div>'
  );
};
$('journal').onclick=journal;

const c9BeginBase=begin;
begin=(resume=false)=>{
  c9IntroShown=false;c9AutoLock=false;
  const r=c9BeginBase(resume);c9RefreshHud();
  // Continuing a save already standing at Broken Crossing should still receive the Story Chronicle.
  setTimeout(()=>{try{if(c9StoryReady())c9DiscoverStoryChronicle();}catch(e){}},0);
  return r;
};
$('begin').onclick=()=>begin(false);$('continue').onclick=()=>begin(true);

// F5.2 had flattened window.WB.state through an object spread, freezing found/elapsed at load time.
// Restore a live state getter so Chronicle and leaderboard metrics read the current run.
if(window.WB){
  Object.defineProperty(window.WB,'state',{configurable:true,enumerable:true,get:()=>({
    player,liora,lioraJoined,active:[...active],found:[...found],bridges,checkpoint,
    willowReached:!!window.WB_F2_ROUTE?.willowReached,
    willowEvent:window.WB_STORY?.willowEvent||'unseen',
    lioraDecision:window.WB_STORY?.lioraDecision||'pending',
    viewpointReached:!!window.WB_F4_FINALE?.viewpointReached,
    aurelianRevealed:!!window.WB_F4_FINALE?.revealSeen,
    map1Complete:!!window.WB_F4_FINALE?.complete,
    companionPuzzleComplete:!!window.WB_F41_COMPANION?.complete,
    lens:0,gateTimer:0,rescues,finished:!!window.WB_F4_FINALE?.complete,elapsed,atlas,paused,dashTime,dashCooldown,
    selected,nav:V2.nav,stranded:V2.stranded,renderOrder:V2.renderOrder
  })});
}

window.WB_CHRONICLE={
  version:C9.version,
  storyIsland:C9.storyIsland,
  optionalIslands:[...C9.optionalIslands],
  get found(){return [...found].sort((a,b)=>a-b);},
  get count(){return c9ChronicleCount();},
  discoverStory:c9DiscoverStoryChronicle
};
if(window.WB){window.WB.version=C9.version;window.WB.begin=begin;window.WB.update=update;}
if(window.WB_MAP_FLOW)window.WB_MAP_FLOW.version=C9.version;
/* F5.5: scoring module owns its own version; Chronicle must not overwrite it. */
document.title='WONDERBOUND — The Living Atlas · F5.5 State & Leaderboard Integrity QA Fix Candidate V11';
const c9Ed=document.querySelector('.edition');if(c9Ed)c9Ed.textContent='F5.5 · STATE + LEADERBOARD INTEGRITY · V11';
const c9Sf=document.querySelector('.startfooter');if(c9Sf)c9Sf.innerHTML='F5.5 / STATE + LEADERBOARD INTEGRITY<br><br>FIND THE STORIES THE MAP ALMOST LOST.';
c9RefreshHud();
})();
</script>



