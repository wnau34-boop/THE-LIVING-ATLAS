<script id="wb-f53-summary-score-v8-script">
(()=>{
'use strict';
const F53={
  version:'map1-f5-5-state-leaderboard-integrity-v11',
  scoringVersion:'map1-score-v3',
  activeKey:'wonderbound_map1_active_run_stats_v3',
  boardKey:'wonderbound_map1_local_leaderboard_v3',
  boardLimit:25,
  weights:{chronicle:.20,lightmarks:.20,stability:.20,bridge:.10,companion:.15,time:.15}
};
let run=null,atlasPersistAge=0;
function nowId(){try{return crypto.randomUUID();}catch(e){return 'run-'+Date.now().toString(36)+'-'+Math.random().toString(36).slice(2,10);}}
function fresh(){return{schemaVersion:2,telemetryVersion:F53.version,scoringVersion:F53.scoringVersion,runId:nowId(),startedAt:new Date().toISOString(),bridgeAttempts:0,bridgeSuccess:0,bridgeReplacements:0,companionCommands:0,companionRecalls:0,recoveries:0,atlasTimeSec:0,finalized:false,completedAt:null};}
function safeGet(k){try{return localStorage.getItem(k);}catch(e){return null;}}
function safeSet(k,v){try{localStorage.setItem(k,v);return true;}catch(e){return false;}}
function loadRun(){
  try{
    const raw=JSON.parse(safeGet(F53.activeKey)||'null');
    if(raw&&raw.schemaVersion===2&&raw.telemetryVersion===F53.version&&raw.scoringVersion===F53.scoringVersion&&raw.runId){run={...fresh(),...raw};return run;}
  }catch(e){}
  run=fresh();run.bridgeSuccess=Math.max(0,Number(weaves)||0);persist();return run;
}
function persist(){if(!run)loadRun();safeSet(F53.activeKey,JSON.stringify(run));}
function pct(v){return Math.max(0,Math.min(100,Math.round(Number(v)||0)));}
function fmt(sec){sec=Math.max(0,Math.round(Number(sec)||0));const h=Math.floor(sec/3600),m=Math.floor(sec%3600/60),s=sec%60;return h?`${h}:${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`:`${m}:${String(s).padStart(2,'0')}`;}
function timePct(sec){const m=Math.max(0,Number(sec)||0)/60;if(m<=12)return 100;if(m<=18)return pct(100-(m-12)*(10/6));if(m<=30)return pct(90-(m-18)*(25/12));if(m<=45)return pct(65-(m-30));return 50;}
function state(){try{return window.WB?.state||{};}catch(e){return{};}}
function metrics(){
  if(!run)loadRun();
  const st=state();let lm={found:0,total:1};try{lm=window.WB_LIGHT_MARKS?.status?.()||lm;}catch(e){}
  const foundList=Array.isArray(st.found)?st.found:[];
  const chronTotal=4,chronFound=Math.max(0,Math.min(chronTotal,foundList.length));
  const lightTotal=Math.max(1,Number(lm.total)||1),lightFound=Math.max(0,Math.min(lightTotal,Number(lm.found)||0));
  const fractures=Math.max(0,Number(window.WB_MAP_FLOW?.map1Fractures)||0),recoveries=Math.max(0,Number(run.recoveries)||0);
  const bridgeSuccess=Math.max(Number(weaves)||0,Number(run.bridgeSuccess)||0),bridgeAttempts=Math.max(bridgeSuccess,Number(run.bridgeAttempts)||0,1);
  const completeCompanion=!!window.WB_F41_COMPANION?.complete;
  const commands=Math.max(completeCompanion?1:0,Number(run.companionCommands)||0),recalls=Math.max(0,Number(run.companionRecalls)||0);
  const worldTime=Math.max(0,Number(st.elapsed)||Number(elapsed)||0),atlasTime=Math.max(0,Number(run.atlasTimeSec)||0),activeTime=worldTime+atlasTime;
  const scores={chronicle:pct(chronFound/chronTotal*100),lightmarks:pct(lightFound/lightTotal*100),stability:pct(100-recoveries*5-fractures*10),bridge:pct(bridgeSuccess/bridgeAttempts*100),companion:pct(completeCompanion?100-Math.max(0,commands-1)*8:0),time:timePct(activeTime)};
  scores.overall=pct(scores.chronicle*F53.weights.chronicle+scores.lightmarks*F53.weights.lightmarks+scores.stability*F53.weights.stability+scores.bridge*F53.weights.bridge+scores.companion*F53.weights.companion+scores.time*F53.weights.time);
  return{pct:scores,score1000:scores.overall*10,raw:{chronicleFound:chronFound,chronicleTotal:chronTotal,lightmarkFound:lightFound,lightmarkTotal:lightTotal,recoveries,fractures,bridgeSuccess,bridgeAttempts,bridgeReplacements:Number(run.bridgeReplacements)||0,companionCommands:commands,companionRecalls:recalls,activeTimeSec:activeTime,atlasTimeSec:atlasTime,worldTimeSec:worldTime}};
}
function loadBoard(){try{const a=JSON.parse(safeGet(F53.boardKey)||'[]');return Array.isArray(a)?a.filter(x=>x&&x.schemaVersion===2&&x.telemetryVersion===F53.version&&x.scoringVersion===F53.scoringVersion&&x.mapId==='wonderhaven-map1-from-azure-gate'):[];}catch(e){return[];}}
function sortBoard(a){return a.sort((x,y)=>(y.score1000-x.score1000)||(x.activeTimeSec-y.activeTimeSec)||(x.recoveries-y.recoveries)||String(x.completedAt).localeCompare(String(y.completedAt)));}
function finalize(){
  if(!run)loadRun();let board=loadBoard(),existing=board.find(x=>x.runId===run.runId);
  if(existing){board=sortBoard(board);return{record:existing,board,rank:board.findIndex(x=>x.runId===run.runId)+1};}
  const m=metrics(),record={schemaVersion:2,telemetryVersion:F53.version,scoringVersion:F53.scoringVersion,mapId:'wonderhaven-map1-from-azure-gate',runId:run.runId,buildVersion:F53.version,startedAt:run.startedAt,completedAt:new Date().toISOString(),overallPct:m.pct.overall,score1000:m.score1000,activeTimeSec:m.raw.activeTimeSec,worldTimeSec:m.raw.worldTimeSec,atlasTimeSec:m.raw.atlasTimeSec,recoveries:m.raw.recoveries,fractures:m.raw.fractures,metrics:m,rankableScope:'local-prototype',serverVerified:false};
