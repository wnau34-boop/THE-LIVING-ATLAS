function scoreCard(v,label,raw,w){return '<div class="scoreStat"><b>'+v+'%</b><span class="statLabel">'+label+'</span><small class="statRaw">'+raw+'</small><small class="statWeight">น้ำหนัก '+Math.round(w*100)+'%</small></div>';}
