<script id="wb-mobile-ux4-script">
(()=>{
'use strict';
const UX4={version:'0.4.1',layoutKey:'wonderbound_touch_layout_v2'};
const defaultLayout={rightEdge:'far',rightGap:'wide',rightHeight:'standard'};
let layout={...defaultLayout};
