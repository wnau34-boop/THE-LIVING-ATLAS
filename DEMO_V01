function toggleAtlas(){S.atlas=!S.atlas;S.selected=null;S.hover=null;keys={};relay.classList.toggle('atlas-open',S.atlas);resetRelayJoy();$r('relayAtlas').classList.toggle('active',S.atlas);$r('relayTouchAtlas').classList.toggle('active',S.atlas);$r('relayTouchAtlas').textContent=S.atlas?'ปิด Atlas':'Atlas';toast('ATLAS',S.atlas?'เลือกหมุดสองจุดเพื่อขีดสะพาน · โลกหยุดขณะวางแผน':'กลับสู่การเดินจริง');updateUI();}
