const beginBase=begin;
begin=(resume=false)=>{if(resume)loadRun();else{run=fresh();persist();}const r=beginBase(resume);if(!resume&&run){run.bridgeSuccess=Math.max(0,Number(weaves)||0);persist();}return r;};
const saveBase=save;save=()=>{const r=saveBase();persist();return r;};
const bridgeBase=addBridge;addBridge=(a,b)=>{if(!run)loadRun();const attempted=started&&!paused&&Number.isInteger(a)&&Number.isInteger(b)&&a!==b,beforeLen=bridges.length;if(attempted)run.bridgeAttempts++;const ok=bridgeBase(a,b);if(ok){run.bridgeSuccess=Math.max(Number(run.bridgeSuccess)||0,Number(weaves)||0);if(beforeLen===3)run.bridgeReplacements++;}if(attempted)persist();return ok;};
const companionBase=companion;companion=()=>{if(!run)loadRun();const pre=state(),track=started&&!paused&&!atlas&&pre.lioraJoined&&!pre.companionPuzzleComplete,preCmd=String(pre.liora?.command||'');const r=companionBase();if(track){const post=state(),postCmd=String(post.liora?.command||'');if(postCmd!==preCmd){run.companionCommands++;if(postCmd==='follow'&&['f41-post','f41-hold'].includes(preCmd))run.companionRecalls++;persist();}}return r;};$('companion').onclick=companion;
