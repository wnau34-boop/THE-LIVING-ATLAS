function moveLiora(dt){
 if(S.liora.hold){S.liora.moving=false;S.liora.navNode=null;return;}
 let targetNode=S.liora.command==='plate'?3:actorNode(S.player);if(targetNode==null){S.liora.moving=false;return;}
